// expect: exit 95

struct Name { len: i32 }
struct User { name: Name?, age: i32? }

fn name_len(u: &User) -> i32 {
    let mut len = 0;
    if let n = &u.name { len = n.len; }
    len
}

// Through a reference that's already a parameter.
fn len_of(name: &(Name?)) -> i32 {
    let mut len = 0;
    if let n = name { len = n.len; }
    len
}

// `&mut` changes the value in place.
fn grow(u: &mut User) {
    if let n = &mut u.name { n.len = n.len * 10; }
}

// A function returning a reference to an optional.
fn slot(u: &mut User) -> &mut (i32?) { &mut u.age }

fn main() -> i32 {
    let mut u = User { name: Name { len: 3 }, age: 4 };
    let default = Name { len: 0 };
    grow(&mut u);
    if let a = slot(&mut u) { *a = *a + 1; }
    let fallback = (&u.name) else &default;
    // The optional is still there to use afterwards: nothing was moved.
    name_len(&u) + len_of(&u.name) + fallback.len + (u.age else 0)
}
