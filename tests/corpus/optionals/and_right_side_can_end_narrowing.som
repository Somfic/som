// expect: error InvalidOperands

struct User { age: i32? }

fn reset(u: &mut User) -> bool { u.age = none; true }

fn main() -> i32 {
    let mut u = User { age: 1 };
    let mut r = 0;
    // `reset` runs after `u.age` was checked, and clears it.
    if u.age and reset(&mut u) { r = u.age + 1; }
    r
}
