// expect: exit 7

/// What's expected of `x else y` is expected of `x` too: `let e: i32 = get(…) else …`
/// picks the `get` that gives an `i32`.
struct Box { v: i32 }

impl Box {
    fn get(&self, i: i32) -> i32? { if i == 0 { .v } else { none } }
    fn get(&self, i: i32) -> bool? { if i == 0 { .v > 0 } else { none } }
}

fn main() -> i32 {
    let b = Box { v: 7 };
    let e: i32 = b.get(0) else @unreachable;
    e
}
