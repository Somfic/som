// expect: exit 7

struct User { age: i32? }

fn slot(u: &mut User) -> &mut (i32?) { &mut u.age }

fn main() -> i32 {
    let mut u = User { age: 1 };
    {
        let age = slot(&mut u);
        if *age { *age = 3; }
    };
    u.age = none;
    if u.age { u.age = 9; }
    u.age = 7;
    u.age else 0
}
