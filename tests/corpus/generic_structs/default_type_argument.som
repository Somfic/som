// expect: exit 7

/// A parameter with a default can be left out: `Pair<i32>` is `Pair<i32, i32>`, since `B`
/// is `A` unless it's given.
struct Pair<A, B = A> { a: A, b: B }

fn main() -> i32 {
    let same: Pair<i32> = Pair { a: 1, b: 2 };
    let mixed: Pair<i32, bool> = Pair { a: 4, b: true };
    same.a + same.b + (mixed.a if mixed.b else 0)
}
