// expect: exit 7

/// A `@where` says what has to be known wherever the function is called. Its body can
/// rely on it.
@where start <= end and end <= values.len
fn total(values: &[i32], start: usize, end: usize) -> i32 {
    let mut sum = 0;
    for i in start..end {
        sum = sum + values[i];
    }
    sum
}

fn main() -> i32 {
    let a = [1, 2, 4, 8];
    let s = a.slice(0..4) else return 0;
    if s.len < 3 {
        return 0;
    }
    total(s, 0, 3)
}
