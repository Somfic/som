// expect: exit 9

use som::io;

/// `@unreachable` reached after all is a failure too, said to be one.
@on fail
fn quit(failure: &Failure) {
    io::exit(9 if failure.unreachable && failure.at.function == "pick" else 1);
}

fn pick(n: i32) -> i32 = n if n > 0 else @unreachable;

fn main() -> i32 = pick(0);
