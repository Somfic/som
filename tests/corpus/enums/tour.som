// expect: exit 24

enum Shape {
    Circle(i32),
    Rect { w: i32, h: i32 },
    Empty,
}

fn area(shape: Shape) -> i32 {
    match shape {
        Circle(r) => 3 * r * r,
        Rect { w, h } => w * h,
        Empty => 0,
    }
}

fn main() -> i32 {
    let a = area(Shape::Circle(2));
    let b = area(Shape::Rect { w: 3, h: 4 });
    let c = area(Shape::Empty);
    a + b + c
}
