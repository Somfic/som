// expect: exit 123

/// The standard library's `collect`, into the `List` the result is expected to be.
fn main() -> i32 {
    let numbers: &[i32] = [1, 2, 3, 4, 5, 6];
    let evens: List<&i32> = numbers.iter().where(x => x % 2 == 0).collect();
    let mut sum = 0;
    for x in &evens {
        sum = sum + x;
    }
    sum * 10 + evens.len as i32
}
