// expect: exit 200

/// An `Alloc` made each time round a loop is given back each time round, and one replaced by
/// assigning a new one is given back as it's replaced.
use som;

fn main() -> i32 {
    let mut total = 0;
    let mut i = 0;
    let mut kept: som::mem::Alloc<i32> = som::mem::Alloc::with_capacity(1);
    while i < 100 {
        let mut mem: som::mem::Alloc<i32> = som::mem::Alloc::with_capacity(64);
        mem.put_at(63, 1);
        total = total + mem.take_at(63);
        kept = som::mem::Alloc::with_capacity(1);
        kept.put_at(0, 1);
        total = total + kept.take_at(0);
        i = i + 1;
    }
    total
}
