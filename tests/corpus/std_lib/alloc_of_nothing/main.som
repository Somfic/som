// expect: exit 5

/// An `Alloc` of a type with nothing in it, `()`, still counts its room.
use som;

fn nothing() {}

fn main() -> i32 {
    let mut mem: som::mem::Alloc<()> = som::mem::Alloc::with_capacity(5);
    mem.put_at(4, nothing());
    let read = mem.take_at(4);
    mem.capacity as i32
}
