// expect: exit 3

/// An `Alloc` is given back whichever way its function ends: an early `return`, or the end.
use som;

fn pick(early: bool) -> i32 {
    let mut mem: som::mem::Alloc<i32> = som::mem::Alloc::with_capacity(2);
    mem.put_at(0, 1);
    mem.put_at(1, 2);
    if early {
        return mem.take_at(0);
    }
    mem.take_at(1)
}

fn main() -> i32 {
    pick(true) + pick(false)
}
