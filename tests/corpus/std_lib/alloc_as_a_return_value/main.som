// expect: exit 6

/// A function makes an `Alloc` and gives it back: the room is its caller's now.
use som;

fn numbers(count: usize) -> som::mem::Alloc<i32> {
    let mut mem: som::mem::Alloc<i32> = som::mem::Alloc::with_capacity(count);
    for i in 0..count {
        mem.put_at(i, i as i32 + 1);
    }
    mem
}

fn main() -> i32 {
    let mut mem = numbers(3);
    mem.take_at(0) + mem.take_at(1) + mem.take_at(2)
}
