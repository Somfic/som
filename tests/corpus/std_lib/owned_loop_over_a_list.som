// expect: exit 9

/// `for x in list` moves the values out of the list, first to last; those not reached when
/// the loop stops early are dropped with it. A queue's are dequeued.
fn main() -> i32 {
    let mut numbers: List<i32> = List::empty();
    numbers.push(1); numbers.push(2); numbers.push(3);
    let mut total = 0;
    for n in numbers { total = total + n; }
    let mut names: List<string> = List::empty();
    names.push("ab"); names.push("c"); names.push("def");
    for name in names {
        if name.len == 1 { break; }
        total = total + name.len as i32;
    }
    let mut queue: Queue<i32> = Queue::empty();
    queue.enqueue(1);
    for n in queue { total = total + n; }
    total
}
