// expect: exit 3

/// `Alloc::with_capacity<u8>(0)`: the type arguments of a function that has none of its own are its
/// type's.
use som;

fn main() -> i32 {
    let empty = som::mem::Alloc::with_capacity<u8>(0);
    let mut three = som::mem::Alloc::with_capacity<u16>(3);
    three.put_at(2, 3);
    empty.capacity as i32 + three.take_at(2) as i32
}
