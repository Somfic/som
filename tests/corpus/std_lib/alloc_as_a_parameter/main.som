// expect: exit 15

/// An `Alloc` is lent to a function to fill it, `&mut`, and given to one that's done with it,
/// which gives the room back.
use som;

fn fill(mem: &mut som::mem::Alloc<i32>, value: i32) {
    for i in 0..mem.size {
        mem.write(i, value);
    }
}

fn sum(mut mem: som::mem::Alloc<i32>) -> i32 {
    let mut total = 0;
    for i in 0..mem.size {
        total = total + mem.read(i);
    }
    total
}

fn main() -> i32 {
    let mut mem: som::mem::Alloc<i32> = som::mem::Alloc::new(5);
    fill(&mut mem, 3);
    sum(mem)
}
