// expect: exit 60

/// Resizing keeps the values in the room that's kept: growing keeps them all, shrinking keeps
/// the first ones.
use som;

fn main() -> i32 {
    let mut mem: som::mem::Alloc<i32> = som::mem::Alloc::with_capacity(2);
    mem.put_at(0, 10);
    mem.put_at(1, 20);
    mem.resize(1000);
    mem.put_at(999, 30);
    let grown = mem.take_at(0) + mem.take_at(1) + mem.take_at(999);
    mem.resize(1);
    let kept = mem.take_at(0) - 10;
    grown + kept + (mem.capacity as i32) - 1
}
