// expect: exit 2

/// An `Alloc` never drops the values in it: dropping it only gives the room back. A value read
/// out of it is the reader's, dropped once like any other.
use som;

struct Noisy { id: i32, log: *i32 }

impl Drop for Noisy {
    fn drop(&mut self) { .log.put(0, .log.take(0) * 10 + .id); }
}

fn main() -> i32 {
    let mut log = 0;
    let at = &mut log as *i32;
    {
        let mut mem: som::mem::Alloc<Noisy> = som::mem::Alloc::with_capacity(2);
        mem.put_at(0, Noisy { id: 1, log: at });
        mem.put_at(1, Noisy { id: 2, log: at });
        let second = mem.take_at(1);
    }
    log
}
