// expect: exit 10

/// `for` goes through a `List`: `&items` lends its values, copies here as they're numbers, and
/// `items` gives them up.
use som::data;
use som::io;

pub fn main() -> i32 {
    let items: List = [1, 2, 3, 4];
    let mut total = 0;
    for item in &items {
        printf("%d\n", item);
    }
    for item in items {
        total = total + item;
    }
    total
}
