// expect: exit 16

/// Built-in types have their traits' methods, called through the trait as they aren't
/// `pub`: `Compare::compare(&x, &y)` on numbers, also through a bound like `T: Compare`, and
/// the methods of a trait implemented for one. Its own impl calls them on values.
struct Hello { a: i32, b: f64 }

impl Compare for Hello {
    fn compare(self: &Hello, other: &Hello) -> Ordering {
        self.a.compare(&other.a)
    }
}

impl Add for bool {
    fn add(self: &bool, other: &bool) -> bool { *self || *other }
}

fn order<T: Compare>(a: T, b: T) -> Ordering { Compare::compare(&a, &b) }
fn total<T: Add>(a: T, b: T) -> T { Add::add(&a, &b) }
fn same<T: Eq>(a: T, b: T) -> bool { Eq::eq(&a, &b) }

fn rank(o: Ordering) -> i32 { match o { Less => 1, Equal => 2, Greater => 3 } }

fn main() -> i32 {
    let x = 3;
    let mut r = rank(Compare::compare(&x, &4));
    r = r * 10 + rank(order(5, 5));
    r = r * 10 + rank(order(2.5, 1.0));
    r = r * 10 + rank(Compare::compare(&Hello { a: 1, b: 0.0 }, &Hello { a: 0, b: 0.0 }));
    let s = total(20, 22) + Multiply::multiply(&7, &3);
    let t = Add::add(&true, &false);
    let f = 1.5;
    let u = same(true, true) && Eq::eq(&x, &3) && !Eq::eq(&f, &2.0);
    if t && u && (Hello { a: 1, b: 0.0 } < Hello { a: 2, b: 0.0 }) { r = r + s; }
    r
}
