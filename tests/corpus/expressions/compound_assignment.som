// expect: exit 94

/// `x += v` is `x = x + v`, and `x -= v` is `x = x - v`: of a variable, a field, or an
/// element. `a..=b` goes up to and including `b`.
struct Counter { n: i32 }

fn main() -> i32 {
    let mut total = 0;
    for i in 1..=10 {
        total += i;
    }
    for i in 0..=2 {
        total -= i;
    }
    let mut c = Counter { n: 5 };
    c.n -= 2;
    let mut xs: List<i32> = [1, 2, 3];
    if xs.len > 1 {
        xs[1] += 40;
    }
    let mut a = [1, 2, 3];
    for i in 0..a.len {
        a[i] += 1;
    }
    // 52 + 3 + 42 - 3
    total + c.n + (xs[1] if xs.len > 1 else 0) - a[1]
}
