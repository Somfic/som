// expect: exit 42

pub struct Point { x: i32, y: i32 }

impl Point {
    pub fn new(x: i32, y: i32) -> Self = Point { x: x, y: y };
    pub fn sum(&self) = self.x + self.y;
}

pub trait Doubled { fn doubled(&self) -> i32 = 0; }

impl Doubled for Point {
    fn doubled(&self) -> i32 = self.sum() * 2;
}

pub fn add(a: i32, b: i32) = a + b;

pub fn main() -> i32 = add(Point::new(10, 11).doubled(), 0);
