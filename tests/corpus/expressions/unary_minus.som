// expect: exit 145

/// `-x` negates a signed integer or a float; `-1` is a literal of its own, so the smallest
/// `i8` can be written.
fn main() -> i32 {
    let a = -5;
    let b: i8 = -128;
    let x = 7;
    let c = -x;
    let f = -2.5;
    let g = -(f * 2.0);
    let d = 10 - -3;
    let e = -a * 2;
    let m = match c { -7 => 1, _ => 0 };
    a + (b as i32) + c + d + e + m + (g as i32)
}
