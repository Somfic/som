// expect: exit 29

use som::data;
use som::mem;

fn main() -> i32 {
    let mut xs: List<i32> = List::empty();
    xs.push(1);
    xs.push(2);
    {
        let second: &mut i32? = xs.get(1);
        if second { *second = 20; }
    }
    {
        let first: &mut i32? = xs.get(0);
        if first { *first = *first + 1; }
    }
    let total = (xs.as_slice().get(0) else 0) + (xs.as_slice().get(1) else 0);
    xs.free();
    total + 7
}
