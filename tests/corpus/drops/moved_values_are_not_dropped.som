// expect: exit 123

/// A moved value is dropped where it ends up, once; one moved on some paths only is dropped
/// where its scope ends if it's still there.
struct Noisy { id: i32, log: *i32 }

impl Drop for Noisy {
    fn drop(self: &mut Noisy) { self.log.write(0, self.log.read(0) * 10 + self.id); }
}

fn take(n: Noisy) {}

fn main() -> i32 {
    let mut log = 0;
    let at = &mut log as *i32;
    {
        let a = Noisy { id: 1, log: at };
        take(a);
        let b = Noisy { id: 2, log: at };
        if log == 1 { take(b); }
        let c = Noisy { id: 3, log: at };
        if log == 0 { take(c); }
    }
    log
}
