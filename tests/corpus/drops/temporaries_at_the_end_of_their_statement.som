// expect: exit 15

/// A temporary is dropped at the end of its statement.
struct Noisy { id: i32, log: *i32 }

impl Drop for Noisy {
    fn drop(self: &mut Noisy) { self.log.write(0, self.log.read(0) * 10 + self.id); }
}

fn main() -> i32 {
    let mut log = 0;
    let at = &mut log as *i32;
    let id = Noisy { id: 1, log: at }.id;
    let after = log;
    after * 10 + id + 4
}
