// expect: exit 131

/// An `if` with an `else` gives the value its branch ends in: as a function's last
/// expression, in a `let`, chained with `else if`. A branch that returns gives none.
fn sign(x: i32) -> i32 {
    if x < 0 { -1 } else if x == 0 { 0 } else { 1 }
}

fn or_zero(x: i32?) -> i32 {
    if x { x } else { 0 }
}

fn first_positive(x: i32) -> i32 {
    let y = if x > 0 { x } else { return 100; };
    y * 2
}

fn main() -> i32 {
    let a = if true { 3 } else { 4 };
    let b: i64 = if a > 2 { let t = a * 2; t as i64 } else { 0 };
    let c = 5 if a == 3 else 6;
    sign(-9) + sign(0) + sign(4) + or_zero(7) + or_zero(none) + first_positive(5)
        + first_positive(-1) + a + (b as i32) + c
}
