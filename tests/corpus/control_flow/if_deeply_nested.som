// expect: exit 42

fn main() -> i32 {
    let x = 5;
    let mut result = 0;
    if x > 0 {
        if x > 3 {
            if x > 4 {
                result = 42;
            } else {
                result = 30;
            }
        } else {
            result = 20;
        }
    } else {
        result = 10;
    }
    result
}
