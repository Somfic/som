// expect: exit 51

fn sum(numbers: [i32]) -> i32 {
    let mut total = 0;
    let mut i = 0;
    while i < numbers.len() {
        total = total + (numbers.get(i) else 0);
        i = i + 1;
    }
    total
}

fn main() -> i32 {
    let a: [i32] = [1, 2, 3];          // a slice
    let b = [1, 2, 3];                 // an array, as before: [i32; 3]
    let c: [mut i32] = [0; 4];         // a writable slice
    c.set(3, 7);
    let d: [u8; 2] = [1, 2];           // an array of u8
    sum(a) + sum([10, 20]) + sum(&b) + (c.get(3) else 0) + [5, 6].len()
}
