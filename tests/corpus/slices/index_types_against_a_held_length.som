// expect: exit 111

fn check(numbers: [i32]) -> i32 {
    let mut r = 0;
    let small: i8 = 2;
    let wide: i128 = 1;
    let negative: i64 = 0 - 1;
    if numbers.get(small) == 30 { r = r + 1; }
    if numbers.get(wide) == 20 { r = r + 10; }
    if numbers.get(negative) == none { r = r + 100; }
    r
}

fn main() -> i32 { check(&[10, 20, 30]) }
