// expect: exit 3

pub struct Vector<N: usize> { values: [i32; N] }

impl Vector<2> { pub fn zero() { Self { values: [0, 0] } } }
impl Vector<3> { pub fn zero() { Self { values: [1, 1, 1] } } }

pub type Vector3 = Vector<3>;

pub fn main() -> i32 {
    let v: Vector3 = Vector::zero();
    v.values[0] + v.values[1] + v.values[2]
}
