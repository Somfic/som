// expect: exit 21

struct Vector<N: usize, T> { values: [T; N] }

impl<T> Vector<2, T> {
    fn of(a: T) { Self { values: [a, a] } }
    fn first(self: &Self) -> &T { &self.values[0] }
}
impl Vector<2, i32> { fn zero() { Self { values: [0, 0] } } }
impl Vector<3, i32> { fn zero() { Self { values: [1, 1, 1] } } }

enum Shape<T> { Empty, Circle(T), Rect { w: T, h: T } }

type Vector3i = Vector<3, i32>;
type Vector2<T> = Vector<2, T>;
type Shapes = Shape<i32>;

fn area(s: Shapes) -> i32 {
    match s {
        Empty => 0,
        Circle(r) => r,
        Rect { w, h } => w * h,
    }
}

fn main() -> i32 {
    // The alias picks which `zero`, with nothing else to go on.
    let a = Vector3i::zero();
    let b = Vector2::of(4);
    let c = Vector3i { values: [2, 2, 2] };
    let e = Shapes::Empty;
    a.values[2] + *b.first() + c.values[0] + area(Shapes::Circle(2)) + area(Shapes::Rect { w: 3, h: 4 }) + area(e)
}
