// expect: exit 121

/// What implements `Index` is indexed like an array, where the index is known to be inside
/// it: `List`, `string`, slices.
fn main() -> i32 {
    let xs: List<i32> = [10, 20, 30];
    let text = "hey";
    if xs.len < 3 or text.len < 2 {
        return 0;
    }
    // 20 + 101 for `e`.
    xs[1] + (text[1] as i32)
}
