// expect: exit 13

/// A `#T` is read through to what it shares: `node.value`, `node.doubled()`, as `get` would.
/// Its own members, `count`, stay its own.
struct Node { value: i32, next: #Node? }

impl Node {
    fn doubled(&self) -> i32 = self.value * 2;
}

fn total(node: #Node) -> i32 {
    let rest = node.next;
    node.value + (total(rest) if rest else 0)
}

fn make() -> #Node = Rc::new(Node { value: 9, next: none });

fn main() -> i32 {
    let last: #Node = Rc::new(Node { value: 4, next: none });
    let first = Rc::new(Node { value: 3, next: last });
    let made = make().value;
    // 3 + 4, and 6 doubled, if `make()` and `count` read right.
    total(first) + first.doubled() + (0 if made == 9 and first.count == 1 else 100)
}
