// expect: exit 55

struct S { n: i32 }

impl S {
    fn sum_to_n(self: S) -> i32 {
        let mut total = 0;
        let mut i = 1;
        while i <= self.n {
            total = total + i;
            i = i + 1;
        }
        total
    }
}

fn main() -> i32 {
    let s = S { n: 10 };
    s.sum_to_n()
}
