// expect: exit 10

struct C { n: i32 }

impl C {
    fn countdown(self: C) -> i32 {
        let mut n = self.n;
        let mut count = 0;
        while n > 0 {
            n = n - 1;
            count = count + 1;
        }
        count
    }
}

fn main() -> i32 {
    let c = C { n: 10 };
    c.countdown()
}
