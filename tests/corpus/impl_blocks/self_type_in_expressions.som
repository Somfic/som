// expect: exit 8

pub struct P { x: i32 }

impl P {
    pub fn new(x: i32) -> Self = P { x };
    pub fn make() -> Self = Self::new(3);
    pub fn lit() -> Self = Self { x: 4 };
    pub fn same(&self) -> &Self = self;
}

pub trait Make { type Item; fn item(&self) -> Self::Item; }

impl Make for P {
    type Item = i32;
    fn item(&self) -> Self::Item = self.x;
}

pub fn main() -> i32 = P::make().x + P::lit().same().x + P::new(1).item();
