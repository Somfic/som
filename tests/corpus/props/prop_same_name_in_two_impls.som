// expect: exit 23

struct Vector<N: usize, T> { values: [T; N] }

impl<T> Vector<2, T> {
    prop last = self.values[1];
}

impl<T> Vector<3, T> {
    prop last = self.values[2];
}

fn main() -> i32 {
    let a: Vector<2, i32> = Vector { values: [1, 2] };
    let b: Vector<3, i32> = Vector { values: [1, 2, 3] };
    a.last * 10 + b.last
}
