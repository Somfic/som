// expect: exit 17

struct Vector<N: usize, T> { values: [T; N] }

impl<T> Vector<3, T> {
    prop x = self.values[0];
    prop y -> T = self.values[1];
    prop z { self.values[2] }
    prop sum -> i32 = 0;
}

impl i32 {
    prop doubled = self * 2;
}

fn main() -> i32 {
    let v: Vector<3, i32> = Vector { values: [1, 5, 2] };
    v.x + v.y.doubled + v.z * 3 - 0
}
