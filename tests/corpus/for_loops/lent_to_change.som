// expect: exit 66

/// `for x in &mut values` lends each value to change, through a `&mut`; `&values` lends them
/// to read, and numbers come as copies.

fn main() -> i32 {
    let mut numbers = [1, 2, 3];
    for n in &mut numbers { *n = *n * 10; }
    let mut list: List<i32> = [1, 2];
    for n in &mut list { *n = *n + 1; }
    let mut total = 0;
    for n in &numbers { total = total + n; }
    for n in &list { total = total + n; }
    total + 1
}
