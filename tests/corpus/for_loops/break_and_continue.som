// expect: exit 97

struct Point { x: i32 }

fn main() -> i32 {
    // continue in for: skip the odd ones; the counter still moves on.
    let mut evens = 0;
    for i in 0..10 {
        if i % 2 == 1 { continue; }
        evens = evens + i;                       // 0 + 2 + 4 + 6 + 8 = 20
    }

    // continue in while: back to the condition.
    let mut i = 0;
    let mut skipped = 0;
    while i < 5 {
        i = i + 1;
        if i == 3 { continue; }
        skipped = skipped + i;                   // 1 + 2 + 4 + 5 = 12
    }

    // continue and break in loop.
    let mut n = 0;
    let mut looped = 0;
    loop {
        n = n + 1;
        if n > 6 { break; }
        if n % 3 == 0 { continue; }
        looped = looped + n;                     // 1 + 2 + 4 + 5 = 12
    }

    // break only leaves the innermost loop.
    let mut pairs = 0;
    for a in 0..4 {
        for b in 0..4 {
            if b > a { break; }
            pairs = pairs + 1;                   // 1 + 2 + 3 + 4 = 10
        }
    }

    // continue only goes on with the innermost loop.
    let mut inner = 0;
    for a in 0..3 {
        for b in 0..3 {
            if b == 1 { continue; }
            inner = inner + 1;                   // 3 * 2 = 6
        }
    }

    // break after locals declared in the body, from deep inside ifs.
    let mut found = 0;
    for x in [5, 10, 15, 20] {
        let doubled = x * 2;
        if doubled > 15 {
            if doubled < 100 {
                found = doubled;                 // 20
                break;
            }
        }
    }

    // break out of a loop that's lending its elements: the borrow ends.
    let mut points = [Point { x: 1 }, Point { x: 7 }, Point { x: 3 }];
    let mut big = 0;
    for p in points {
        if p.x > 5 { big = p.x; break; }         // 7
    }
    points.set(0, Point { x: 100 });             // free again after the loop

    // continue as the last thing in a body, and in an else branch.
    let mut kept = 0;
    for v in 1..5 {
        if v == 2 { kept = kept + 10; } else { continue; }
    }                                            // 10

    evens + skipped + looped + pairs + inner + found + big + kept
}
