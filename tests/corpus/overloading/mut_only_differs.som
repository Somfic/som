// expect: error MutOverload

/// Overloads differing only in `&` and `&mut` are an error: which one runs would depend on
/// whether the caller has a `&mut`. Taking `self` or `&self` is fine.
struct Cell { value: i32 }
impl Cell {
    fn read(self) -> i32 { self.value }
    fn read(&self) -> &i32 { &self.value }
    fn view(&self) -> &i32 { &self.value }
    fn view(&mut self) -> &mut i32 { &mut self.value }
}

fn main() -> i32 { 0 }
