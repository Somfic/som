// expect: error ConstFailed

/// A function of your own that fails: `@fail` stops it with a message, here while compiling.
fn parse_digit(c: u8) -> i32 {
    if c < 48 || c > 57 { @fail("not a digit: {c}"); }
    (c - 48) as i32
}

@const SEVEN = parse_digit(55);
@const BAD = parse_digit(120);

fn main() -> i32 = SEVEN + BAD;
