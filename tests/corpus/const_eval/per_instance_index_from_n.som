// expect: exit 42

struct Row<N: usize> {
    cells: [i32; N],
}

/// In each instance, `N` is known: `.cells[N - 1]` is proven in bounds, which checked once,
/// generically, it can't be.
impl<N: usize> Row<N> {
    fn last(&self) -> i32 {
        @if N >= 1 {
            return .cells[N - 1];
        } else {
            return 0;
        }
    }
}

fn main() -> i32 {
    let row = Row { cells: [1, 2, 42] };
    return row.last();
}
