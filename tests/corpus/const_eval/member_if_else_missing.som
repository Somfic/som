// expect: error MemberNotHere

struct Row<N: usize> {
    cells: [i32; N],
}

impl<N: usize> Row<N> {
    @if N >= 3 {
        pub prop third = .cells[2];
    } else @if N == 2 {
        pub fn last(&self) -> i32 = .cells[1];
    }
}

/// `last` is only there where `!(N >= 3) && N == 2`.
fn main() -> i32 = Row { cells: [1, 2, 3] }.last();
