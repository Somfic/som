// expect: exit 42

struct Row<N: usize> {
    cells: [i32; N],
}

/// An `@if` on an impl block's `N`, in a method.
impl<N: usize> Row<N> {
    fn third(&self) -> i32 {
        @if N >= 3 {
            return .cells[2];
        } else {
            return 0;
        }
    }
}

fn main() -> i32 {
    let short = Row { cells: [1, 2] };
    let long = Row { cells: [1, 2, 42] };
    return short.third() + long.third();
}
