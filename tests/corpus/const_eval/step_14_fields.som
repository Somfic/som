// expect: exit 42

struct Struct {
    hello: bool,
    bye: i32
}

/// Each field compared: `f` is written as each field's name.
fn fields_eq(a: &Struct, b: &Struct) -> bool {
    @for f in Struct { if a.f != b.f { return false; } }
    true
}

/// With its index too.
fn weighted(s: &Struct) -> i32 {
    let mut total = 0;
    @for (i, f) in Struct {
        @if i == 1 { total = total + s.f * 10; }
    }
    total
}

fn main() -> i32 {
    let a = Struct { hello: true, bye: 4 };
    let b = Struct { hello: true, bye: 4 };
    let c = Struct { hello: false, bye: 4 };
    let same = 1 if fields_eq(&a, &b) else 0;
    let different = 0 if fields_eq(&a, &c) else 1;
    return same + different + weighted(&a);
}
