// expect: exit 42

/// An array of arrays, worked out while compiling.
fn identity() -> [[i32; 3]; 3] {
    let mut m = [[0; 3]; 3];
    for i in 0..3 { m[i][i] = 1; }
    m
}

@const IDENTITY = identity();

fn main() -> i32 {
    let mut sum = 0;
    for row in IDENTITY {
        for x in row { sum = sum + x; }
    }
    return sum * 14;
}
