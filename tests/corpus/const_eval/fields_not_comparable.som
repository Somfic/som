// expect: error

struct Holder {
    items: List<i32>,
}

fn fields_eq<T>(a: &T, b: &T) -> bool {
    @for f in T { if a.f != b.f { return false; } }
    true
}

/// A `List` can't be compared with `!=`: said as `fields_eq<Holder>`'s error, where it's used.
fn main() -> i32 {
    let a = Holder { items: List::empty() };
    let b = Holder { items: List::empty() };
    return 1 if fields_eq(&a, &b) else 0;
}
