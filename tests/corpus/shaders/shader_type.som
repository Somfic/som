// expect: exit 0

/// `gpu::Shader::fragment(shader)`: the shader's WGSL, worked out from the shader; `each`
/// gives each uniform's index, name and value, for the host to set.
use som::gpu;

struct Uniforms {
    pub time: f32,
    pub count: i32,
    pub tint: Vector<4, f32>,
}

@fragment
fn tinted(frag: Fragment, u: &Uniforms) -> Vector<4, f32> {
    u.tint * f32::sin(frag.uv.x + u.time)
}

fn main() -> i32 {
    let compiled = gpu::Shader::fragment(tinted);
    if compiled.wgsl != gpu::shader(tinted) { return 1; }

    // Each uniform, with its index and name: written out per field, no list.
    let names = ["time", "count", "tint"];
    compiled.each(&Uniforms { time: 1.5, count: 7, tint: Vector::new([1.0, 0.5, 0.0, 1.0]) }, (i, name, value) => {
        let expected = names.get(i) else @unreachable;
        assert(string::from_c(name) == expected);
        let fits = match value {
            gpu::Uniform::Float(t) => i == 0 && t == 1.5,
            gpu::Uniform::Int(n) => i == 1 && n == 7,
            gpu::Uniform::Vec4(v) => i == 2 && v[1] == 0.5,
            _ => false,
        };
        assert(fits);
    });
    0
}
