// expect: exit 0

/// The vectors shaders use: `Vec4`, `vec4(rgb, a)`, swizzles, `dot`, `normalized`, `mix`,
/// `clamp`, on the CPU as on the GPU, where each is WGSL's own.
struct Uniforms { pub tint: Vec4, pub light: Vec3 }

@fragment
fn lit(frag: Fragment, u: &Uniforms) -> Vec4 {
    let p = vec3(frag.uv * 2.0 - vec2(1.0, 1.0), 1.0);
    let shade = p.normalized.dot(&u.light.normalized).clamp(0.0, 1.0);
    vec4(u.tint.rgb.mix(&vec3(1.0, 1.0, 1.0), shade), u.tint.a)
}

fn main() -> i32 {
    let v = vec3(1.0, 2.0, 2.0);
    if v.length != 3.0 { return 1; }
    if v.dot(&v) != 9.0 { return 2; }
    if vec4(v * 0.5, 1.0).rgb.z != 1.0 { return 3; }
    if vec2(0.0, 0.0).mix(&vec2(2.0, 4.0), 0.5).y != 2.0 { return 4; }
    if vec3(-2.0, 0.5, 9.0).clamp(0.0, 1.0).dot(&vec3(1.0, 1.0, 1.0)) != 1.5 { return 5; }
    // Straight on: lit fully, so the tint mixes all the way to white.
    let frag = Fragment { uv: vec2(0.5, 0.5), color: vec4(1.0, 1.0, 1.0, 1.0), position: vec4(0.0, 0.0, 0.0, 1.0) };
    let c = lit(frag, &Uniforms { tint: vec4(1.0, 0.0, 0.0, 0.5), light: vec3(0.0, 0.0, 1.0) });
    if c.g != 1.0 || c.a != 0.5 { return 6; }
    0
}
