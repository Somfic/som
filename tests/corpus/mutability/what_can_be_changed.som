// expect: exit 42

struct Point { x: i32, y: i32 }

// A `mut` parameter can be assigned.
fn double(mut n: i32) -> i32 {
    n = n * 2;
    n
}

// Through a `&mut`, even in a variable that isn't `mut` itself.
fn move_right(p: &mut Point) { p.x = p.x + 1; }

fn main() -> i32 {
    let mut p = Point { x: 1, y: 2 };
    p.y = 10;
    let mut n = 3;
    {
        let r = &mut p;
        move_right(r);
        let m = &mut n;
        *m = 4;
    };
    double(p.x) + p.y + n + 24
}
