// expect: exit 18

/// A `string`'s bytes, one at a time: `get` gives each, and `none` past its end.
fn count(text: string, byte: u8) -> i32 {
    let mut n = 0;
    let mut i = 0;
    while i < text.len {
        if text.get(i) == byte { n = n + 1; }
        i = i + 1;
    }
    n
}

fn main() -> i32 {
    let greeting = "hello, world";
    let copied = string::from_c("abc");
    // 3 `l`s, 12 bytes, and 3 more.
    count(greeting, 108) + greeting.len as i32 + copied.len as i32
}
