// expect: exit 5

/// A reference or an optional is written into text too: what it refers to or holds, or
/// `none`.
fn main() -> i32 {
    let n = 5;
    let r = &n;
    let xs: List<i32> = [10, 20];
    let missing: string? = none;
    let right = "{r}" == "5" && "ref: {r}" == "ref: 5"
        && "{xs.get(1)}" == "20" && "{xs.get(9)}" == "none"
        && "maybe: {missing}" == "maybe: none";
    5 if right else 0
}
