// expect: exit 42

/// A number becomes text by writing it into text, `"{n}"`, or with `to_string`: never by
/// itself. One nothing else decides is the `i32` or `f64` it'd be anyway.
fn label(n: i32) -> string = "{n}";

fn main() -> i32 {
    let a = 1234.to_string();
    let b = "{-5}";
    let c = 2.5.to_string();
    let d = (255 as u8).to_string();
    let e = true.to_string();
    let f = label(7);
    // 4 + 2 + 3 + 3 + 4 + 1 bytes, and 25 more if they all read right.
    let right = a == "1234" and b == "-5" and c == "2.5" and d == "255" and e == "true"
        and f == "7";
    (a.len + b.len + c.len + d.len + e.len + f.len) as i32 + (25 if right else 0)
}
