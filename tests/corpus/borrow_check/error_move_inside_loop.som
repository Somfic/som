// expect: error UseAfterMove

// The second iteration uses `b` after the first one moved it.
struct Big { a: i32, b: i32, c: i32 }
fn take(x: Big) -> i32 { x.a }
fn main() -> i32 {
    let b = Big { a: 1, b: 2, c: 3 };
    let mut i = 0;
    while i < 2 {
        take(b);
        i = i + 1;
    }
    0
}
