// expect: exit 12

/// The standard library's `where`, on a slice's lent values: `x` is a `&&i32`, read through
/// by `%` and `+` with no `*` written.
fn main() -> i32 {
    let a: &[i32] = [1, 2, 3, 4, 5, 6];
    let mut n = 0;
    for x in a.iter().where(x => x % 2 == 0) {
        n = n + x;
    }
    n
}
