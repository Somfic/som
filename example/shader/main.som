use extern "raylib";
use som::mem;
use som::gpu;

/// What the shader is told each frame. Each field is a uniform, set by its name.
struct Uniforms {
    pub time: f32,
    pub tint: Vector<4, f32>,
}

fn wave(x: f32, t: f32) -> f32 {
    f32::sin(x * 10.0 + t)
}

/// Runs on the GPU for each pixel of what's drawn with it: stripes that move with `time`.
@fragment
fn stripes(frag: Fragment, u: &Uniforms) -> Vector<4, f32> {
    let k = 0.5 + 0.5 * wave(frag.uv.x + frag.uv.y, u.time);
    let c = u.tint * k;
    Vector::new([c.x, c.y, c.z, 1.0])
}

fn main() {
    init_window(800, 450, "som shader");
    set_target_fps(60);

    let shader: RaylibShader<Uniforms> = gpu::Shader::fragment(stripes);
    let white = Color { r: 255, g: 255, b: 255, a: 255 };
    let image = gen_image_color(800, 450, white);
    let canvas = load_texture_from_image(image);
    unload_image(image);

    while !window_should_close() {
        shader.set(&Uniforms {
            time: get_time() as f32,
            tint: Vector::new([0.3, 0.7, 1.0, 1.0]),
        });

        begin_drawing();
        clear_background(Color { r: 0, g: 0, b: 0, a: 255 });
        begin_shader_mode(shader.raw);
        draw_texture(canvas, 0, 0, white);
        end_shader_mode();
        draw_fps(10, 10);
        end_drawing();
    }

    // Before the window: raylib's GPU state goes with it.
    drop(shader);
    unload_texture(canvas);
    close_window();
}
