use extern "raylib";
use som::mem;

/// What the shader is told each frame: set on the GPU by name, through raylib.
struct Uniforms {
    time: f32,
    tint: Vector<4, f32>,
}

fn wave(x: f32, t: f32) -> f32 {
    f32::sin(x * 10.0 + t)
}

/// Runs on the GPU for each pixel of what's drawn with it: stripes that move with `time`.
@fragment
fn stripes(frag: Fragment, u: &Uniforms) -> Vector<4, f32> {
    let k = 0.5 + 0.5 * wave(frag.uv.x + frag.uv.y, u.time);
    let c = u.tint * k;
    Vector::new([c.x, c.y, c.z, 1.0])
}

fn main() {
    init_window(800, 450, "som shader");
    set_target_fps(60);

    let shader = load_shader_from_memory(null() as cstr, @glsl(stripes).c_str);
    let time_at = get_shader_location(shader, "time");
    let tint_at = get_shader_location(shader, "tint");

    let image = gen_image_color(800, 450, Color { r: 255, g: 255, b: 255, a: 255 });
    let canvas = load_texture_from_image(image);
    unload_image(image);

    let tint: [f32; 4] = [0.3, 0.7, 1.0, 1.0];
    while !window_should_close() {
        let time = get_time() as f32;
        set_shader_value(shader, time_at, &time as *, ShaderUniformDataType::Float as i32);
        set_shader_value(shader, tint_at, &tint as *, ShaderUniformDataType::Vec4 as i32);

        begin_drawing();
        clear_background(Color { r: 0, g: 0, b: 0, a: 255 });
        begin_shader_mode(shader);
        draw_texture(canvas, 0, 0, Color { r: 255, g: 255, b: 255, a: 255 });
        end_shader_mode();
        draw_fps(10, 10);
        end_drawing();
    }

    unload_texture(canvas);
    unload_shader(shader);
    close_window();
}
