extern "c";

//
fn first_primes<N: usize>() -> [i32; N] {
    let mut found: List<i32> = List::empty();
    let mut n = 2;
    while found.len < N {
        let mut prime = true;
        for p in &found { if p != 0 && n % p == 0 { prime = false; } }
        if prime { found.push(n); }
        n = n + 1;
    }
    let mut table = [0; N];
    for i in 0..N { table[i] = *found.at(i); }
    table
}
@const PRIMES = first_primes<100>();
for value in PRIMES {
    c::printf("prime", value);
}
