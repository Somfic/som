use extern "raylib";
use som::mem;
use som::gpu;

// A shader written where it's drawn: the closure runs on the GPU for each pixel, and what it
// captures, `time`, is its uniform.

fn main() {
    init_window(800, 450, "shader");
    let mut shader = RaylibShader::empty();

    while !window_should_close() {
        let time = get_time() as f32;
        begin_drawing();
        shader.fullscreen((frag: Fragment) => {
            let t = 0.5 + 0.5 * time.sin();
            vec4(frag.uv.x, t, 1.0 - t, 1.0)
        });
        end_drawing();
    }
    drop(shader);
    close_window();
}

/// A shader written as a closure, loaded into raylib the first time it's drawn: a smaller
/// `shader/raylib_shader.som`.
struct RaylibShader<U> {
    raw: raylib::Shader,
    loaded: bool,
    shader: gpu::Shader<U>,
    blank: raylib::Texture,
}

impl<U> RaylibShader<U> {
    fn empty() -> RaylibShader<U> {
        RaylibShader {
            raw: raylib::Shader { id: 0, locs: null() },
            loaded: false,
            shader: gpu::Shader { glsl: "" },
            blank: raylib::Texture { id: 0, width: 0, height: 0, mipmaps: 0, format: 0 },
        }
    }

    /// The shader, closure `uniforms`, over the whole screen.
    fn fullscreen(&mut self, uniforms: U) {
        if !self.loaded {
            self.shader = gpu::Shader::closure(&uniforms);
            self.raw = load_shader_from_memory(null() as cstr, self.shader.glsl.c_str);
            let pixel = gen_image_color(1, 1, Color { r: 255, g: 255, b: 255, a: 255 });
            self.blank = load_texture_from_image(pixel);
            unload_image(pixel);
            self.loaded = true;
        }
        begin_shader_mode(self.raw);
        self.shader.each(&uniforms, (i, name, value) => {
            let at = get_shader_location(self.raw, name);
            match value {
                gpu::Uniform::Float(x) => set_shader_value(self.raw, at, &x as *, ShaderUniformDataType::Float as i32),
                gpu::Uniform::Int(x) => set_shader_value(self.raw, at, &x as *, ShaderUniformDataType::Int as i32),
                gpu::Uniform::Vec4(v) => set_shader_value(self.raw, at, &v as *, ShaderUniformDataType::Vec4 as i32),
                _ => {}
            }
        });
        let whole = Rectangle { x: 0.0, y: 0.0, width: 1.0, height: 1.0 };
        let screen = Rectangle { x: 0.0, y: 0.0, width: get_screen_width() as f32, height: get_screen_height() as f32 };
        let white = Color { r: 255, g: 255, b: 255, a: 255 };
        draw_texture_pro(self.blank, whole, screen, Vector2 { x: 0.0, y: 0.0 }, 0.0, white);
        end_shader_mode();
    }
}

impl<U> Drop for RaylibShader<U> {
    fn drop(&mut self) {
        if self.loaded {
            unload_texture(self.blank);
            unload_shader(self.raw);
        }
    }
}
