extern "raylib";
extern "box2d" from "box2d/box2d.h";

let scale = 30.0; // pixels per meter

let mut world_def = box2d::b2_default_world_def();
world_def.gravity = box2d::B2Vec2 { x: 0.0, y: 0.0 };
let world = box2d::b2_create_world(&world_def);

// walls around the window: floor (on top of the drawn ground), ceiling, left, right
let ground_def = box2d::b2_default_body_def();
let ground = box2d::b2_create_body(world, &ground_def);
let ground_shape = box2d::b2_default_shape_def();
let left = 0.0;
let right = 800.0 / scale;
let top = 0.0;
let bottom = 560.0 / scale;
let top_left = box2d::B2Vec2 { x: left, y: top };
let top_right = box2d::B2Vec2 { x: right, y: top };
let bottom_left = box2d::B2Vec2 { x: left, y: bottom };
let bottom_right = box2d::B2Vec2 { x: right, y: bottom };
box2d::b2_create_segment_shape(ground, &ground_shape, &box2d::B2Segment { point1: bottom_left, point2: bottom_right });
box2d::b2_create_segment_shape(ground, &ground_shape, &box2d::B2Segment { point1: top_left, point2: top_right });
box2d::b2_create_segment_shape(ground, &ground_shape, &box2d::B2Segment { point1: top_left, point2: bottom_left });
box2d::b2_create_segment_shape(ground, &ground_shape, &box2d::B2Segment { point1: top_right, point2: bottom_right });

let radius = 0.1;
let mut balls = List::empty();
let mut i = 0;
while i < 100000 {
    let mut def = box2d::b2_default_body_def();
    def.type_ = 2; // b2_dynamicBody
    def.position = box2d::B2Vec2 { x: (i % 10) as f32 * radius, y: (i / 10) as f32 * radius };
    // a few m/s, pointing a random angle within 30 degrees of straight up
    let angle = (raylib::get_random_value(-30, 30) as f32 - 90.0) * 3.14159 / 180.0;
    def.linear_velocity = box2d::B2Vec2 { x: f32::cos(angle) * 4.0, y: f32::sin(angle) * 4.0 };
    let body = box2d::b2_create_body(world, &def);
    let mut shape = box2d::b2_default_shape_def();
    shape.material.restitution = 1.0;
    shape.material.friction = 0.0;
    let circle = box2d::B2Circle { center: box2d::B2Vec2 { x: 0.0, y: 0.0 }, radius: radius };
    box2d::b2_create_circle_shape(body, &shape, &circle);
    balls.push(body);
    i = i + 1;
}

raylib::init_window(800, 600, "balls".c_str);
raylib::set_target_fps(60);

while !raylib::window_should_close() {
    box2d::b2_world_step(world, 1.0 / 60.0, 4);

    raylib::begin_drawing();
    raylib::clear_background(raylib::Color { r: 20, g: 20, b: 30, a: 255 });
    raylib::draw_rectangle(0, 560, 800, 40, raylib::Color { r: 90, g: 90, b: 110, a: 255 });
    for ball in &balls {
        let p = box2d::b2_body_get_position(ball);
        raylib::draw_circle((p.x * scale) as i32, (p.y * scale) as i32, radius * scale, raylib::Color { r: 230, g: 80, b: 80, a: 255 });
    }
    raylib::end_drawing();
}

raylib::close_window();


printf
