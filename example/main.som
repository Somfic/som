use som::data;
struct Vector<N: usize, T> {
    values: [T; N]
}

impl<N: usize, T> Vector<N, T> {
    fn empty(empty: T) -> Vector<N, T> {
        Vector { values: [empty; N] }
    }
}

impl<T> Vector<3, T> {
    prop x(self: &Vector<3, T>) {
        self.values.get(0)
    }

    prop y(self: &Vector<3, T>) {
        self.values.get(1)
    }

    prop z(self: &Vector<3, T>) {
        self.values.get(2)
    }
}

let v: Vector<3, i32> = Vector::empty(0);
let a = v.y;


