let a = true;
let b = false;

struct Hello {
    a: i32
}

impl Compare for Hello {
    fn compare(self: &Hello, other: &Hello) -> Ordering {
        self.compare(other)
    }
}

impl Eq for Hello {
    fn eq(self: &Hello, other: &Hello) -> bool {
        self.a == other.a
    }
}

Hello { a: 1 } > Hello { a: 1 }
