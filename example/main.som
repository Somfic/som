use std;
enum Test<T> {
    A { base: i32, a: T },
    B { base: i32, b: T }
}

impl<T> Test<T> {
    fn common(self: &Test<T>) -> i32 {
        return self.base;
    }
}

let a = Test::A { base: 1, a: 1 };

&a.common();

let base = match a {
    A { base, a } => base,
    B { base, b } => base
};

std::printf("%d", a.base);
