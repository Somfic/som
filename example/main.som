use std;
extern "raylib";
extern "box2d";

// box2d works in meters with y pointing up; the screen is in pixels with y pointing down.
fn to_screen(p: box2d::B2Vec2) -> raylib::Vector2 {
    raylib::Vector2 { x: 400.0 + p.x * 30.0, y: 420.0 - p.y * 30.0 }
}

fn vec(x: f32, y: f32) -> box2d::B2Vec2 {
    box2d::B2Vec2 { x: x, y: y }
}

fn color(r: u8, g: u8, b: u8) -> raylib::Color {
    raylib::Color { r: r, g: g, b: b, a: 255 }
}

/// A ball that falls, rolls and bounces: the higher `bounce`, the more it keeps.
fn ball(world: box2d::B2WorldId, x: f32, y: f32, bounce: f32) -> box2d::B2BodyId {
    let mut def = box2d::b2_default_body_def();
    def.type = 2; // b2_dynamicBody
    def.position = vec(x, y);
    let body = box2d::b2_create_body(world, &def);

    let mut shape = box2d::b2_default_shape_def();
    shape.material.restitution = bounce;
    let circle = box2d::B2Circle { center: vec(0.0, 0.0), radius: 0.5 };
    box2d::b2_create_circle_shape(body, &shape, &circle);
    body
}

/// A fixed line from `a` to `b` on the static `ground` body.
fn wall(ground: box2d::B2BodyId, a: box2d::B2Vec2, b: box2d::B2Vec2) {
    let shape = box2d::b2_default_shape_def();
    let segment = box2d::B2Segment { point1: a, point2: b };
    box2d::b2_create_segment_shape(ground, &shape, &segment);
}

fn draw_wall(a: box2d::B2Vec2, b: box2d::B2Vec2) {
    raylib::draw_line_ex(to_screen(a), to_screen(b), 4.0, color(80, 80, 80));
}

fn draw_ball(body: box2d::B2BodyId, c: raylib::Color) {
    raylib::draw_circle_v(to_screen(box2d::b2_body_get_position(body)), 15.0, c);
}

fn main() {
    let mut world_def = box2d::b2_default_world_def();
    world_def.gravity = vec(0.0, 0.0 - 10.0);
    let world = box2d::b2_create_world(&world_def);

    // The floor, two side walls and a ramp.
    let ground = box2d::b2_create_body(world, &box2d::b2_default_body_def());
    let floor_left = vec(0.0 - 12.0, 0.0);
    let floor_right = vec(12.0, 0.0);
    let ramp_top = vec(0.0 - 12.0, 9.0);
    let ramp_bottom = vec(0.0 - 3.0, 4.0);
    let right_top = vec(12.0, 13.0);
    wall(ground, floor_left, floor_right);
    wall(ground, floor_left, ramp_top);
    wall(ground, floor_right, right_top);
    wall(ground, ramp_top, ramp_bottom);

    // Ten balls, until som has arrays: each needs its own name.
    let b1 = ball(world, 0.0 - 10.0, 12.0, 0.1);
    let b2 = ball(world, 0.0 - 8.5, 14.0, 0.2);
    let b3 = ball(world, 0.0 - 7.0, 16.0, 0.3);
    let b4 = ball(world, 0.0 - 4.0, 12.0, 0.4);
    let b5 = ball(world, 0.0 - 1.0, 14.0, 0.5);
    let b6 = ball(world, 1.5, 11.0, 0.6);
    let b7 = ball(world, 3.5, 15.0, 0.7);
    let b8 = ball(world, 6.0, 12.0, 0.8);
    let b9 = ball(world, 8.0, 16.0, 0.9);
    let b10 = ball(world, 10.0, 13.0, 0.95);

    raylib::init_window(800, 450, "som + raylib + box2d");
    raylib::set_target_fps(60);
    while !raylib::window_should_close() {
        box2d::b2_world_step(world, 1.0 / 60.0, 4);

        raylib::begin_drawing();
        raylib::clear_background(color(245, 245, 245));
        draw_wall(floor_left, floor_right);
        draw_wall(floor_left, ramp_top);
        draw_wall(floor_right, right_top);
        draw_wall(ramp_top, ramp_bottom);
        // From barely bouncing (dark red) to very bouncy (purple).
        draw_ball(b1, color(190, 33, 55));
        draw_ball(b2, color(230, 41, 55));
        draw_ball(b3, color(255, 120, 0));
        draw_ball(b4, color(255, 190, 0));
        draw_ball(b5, color(160, 200, 0));
        draw_ball(b6, color(0, 158, 47));
        draw_ball(b7, color(0, 180, 170));
        draw_ball(b8, color(0, 121, 241));
        draw_ball(b9, color(80, 70, 220));
        draw_ball(b10, color(150, 60, 200));
        raylib::draw_text("bounce: 0.1 (red) to 0.95 (purple)", 10, 10, 20, color(80, 80, 80));
        raylib::end_drawing();
    }

    raylib::close_window();
    box2d::b2_destroy_world(world);
}
