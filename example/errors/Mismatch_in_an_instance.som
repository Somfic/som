// Mismatch: An `@if` on a generic function's `N` is checked for each instance used: wrong only in `describe<2>`, it's said as that instance's error, and where it's used.

fn describe<N: usize>() -> i32 {
    @if N == 2 {
        let wrong: i32 = "two";
        return wrong;
    } else {
        return 1;
    }
}

fn main() -> i32 = describe<2>();
