// Parse: an `@if` among an impl block's members has no `else` yet: write a second `@if` with the opposite condition.

struct Row<N: usize> { cells: [i32; N] }

impl<N: usize> Row<N> {
    @if N >= 3 {
        pub prop third = .cells[2];
    } else {
        pub prop third = 0;
    }
}

fn main() -> i32 = 0;
