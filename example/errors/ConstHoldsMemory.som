// ConstHoldsMemory: A constant's value points to memory that only exists while compiling.

/// A `List`'s elements are in memory that only exists while compiling.
fn numbers() -> List<i32> {
    let mut list: List<i32> = List::empty();
    list.push(1);
    list
}

@const NUMBERS = numbers();

fn main() -> i32 = NUMBERS.len as i32;
