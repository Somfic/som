// MemberMaybeNotHere: a `Row<N>` of any `N` may not have `third`: use it in `@if N >= 3 { … }`, checked for each instance.

struct Row<N: usize> { cells: [i32; N] }

impl<N: usize> Row<N> {
    @if N >= 3 {
        pub prop third = .cells[2];
    }
}

fn third_of<N: usize>(row: &Row<N>) -> i32 = row.third;

fn main() -> i32 = third_of(&Row { cells: [1, 2, 3] });
