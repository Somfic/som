use som::gpu;

// Shaders written where they're drawn, on WebGPU: each closure runs on the GPU for each
// pixel, compiled to WGSL, and what it captures is its uniforms. `example/main.som` draws
// the first the same way with raylib and GLSL.

fn main() {
    let mut gpu = Gpu::open("wgpu", 800, 450);
    let mut grid = gpu::Grid::of(4, 4, &[
        1, 0, 0, 2,
        0, 3, 0, 0,
        0, 0, 3, 0,
        2, 0, 0, 1,
    ]);
    gpu.load_grid(&mut grid);
    let mut background = WgpuShader::empty();
    let mut tiles = WgpuShader::empty();
    while gpu.frame() {
        let time = gpu.time();
        background.fullscreen(&mut gpu, (frag) => {
            let t = 0.5 + 0.5 * time.sin();
            vec4(frag.uv.x, t, 1.0 - t, 1.0)
        });

        // A texture and an array among the captures: the grid's cells, each kind its colour.
        let map = grid.texture;
        let colours = [vec4(0.1, 0.1, 0.1, 1.0), vec4(0.9, 0.3, 0.2, 1.0), vec4(0.2, 0.8, 0.3, 1.0), vec4(0.95, 0.9, 0.3, 1.0)];
        let pulse = 0.75 + 0.25 * (time * 3.0).sin();
        let side = gpu.height as f32 / 2.0;
        tiles.draw(&mut gpu, 24.0, 24.0, side, side, (frag) => {
            let x = (frag.uv.x * 4.0) as i32;
            let y = (frag.uv.y * 4.0) as i32;
            let kind = map.cell(x, y);
            let mut colour = colours[0];
            for i in 0..4 {
                if i == kind {
                    colour = colours[i];
                }
            }
            vec4(colour.r * pulse, colour.g * pulse, colour.b * pulse, 1.0)
        });
        gpu.present();
    }
}
