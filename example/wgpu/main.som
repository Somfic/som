use som::gpu;
use wgpu;

// som on the GPU: shaders and compute kernels written in som, compiled to WGSL while
// compiling, drawn and run with `som::wgpu`. A shader is a closure written where it's drawn,
// whose captures are its uniforms, or a `@fragment` function with a struct of uniforms; a
// kernel is a closure given an item's index. `example/life` does more with kernels.

/// What `stripes` is told each frame: each field a uniform.
struct Stripes {
    pub time: f32,
    pub tint: Vec4,
    pub image: gpu::Texture,
}

/// `image` at `uv`, rippling with `time`.
fn ripple(image: &gpu::Texture, uv: Vec2, time: f32) -> Vec4 {
    let offset = vec2(0.0, 0.02 * (uv.x * 20.0 + time * 3.0).sin());
    image.sample(uv + offset)
}

/// Runs on the GPU for each pixel of what's drawn with it: a checkerboard, rippling, and lit
/// by stripes that move with `time`. An ordinary function too, which the CPU can call.
@fragment
fn stripes(frag: Fragment, u: &Stripes) -> Vec4 {
    let k = 0.6 + 0.4 * ((frag.uv.x + frag.uv.y) * 10.0 + u.time).sin();
    let c = ripple(&u.image, frag.uv, u.time);
    vec4(c.rgb * u.tint.rgb * k, 1.0)
}

fn main() {
    let mut gpu = wgpu::Gpu::open("wgpu", 960, 540);
    checked(&mut gpu);

    // A grid of cell kinds, and a checkerboard: textures the shaders sample.
    let mut grid = gpu::Grid::of(4, 4, &[
        1, 0, 0, 2,
        0, 3, 0, 0,
        0, 0, 3, 0,
        2, 0, 0, 1,
    ]);
    gpu.load_grid(&mut grid);
    let mut pixels: [u32; 64 * 64] = [0; 64 * 64];
    for i in 0..pixels.len {
        let light = ((i % 64) / 8 + (i / 64) / 8) % 2 == 0;
        pixels[i] = if light { 4294967295 } else { 4282394664 };
    }
    let checks = gpu.load_texture(64, 64, &pixels as *);

    let mut background = wgpu::Shader::empty();
    let mut tiles = wgpu::Shader::empty();
    let mut striped: wgpu::Shader<Stripes> = wgpu::Shader::fragment(stripes);
    let mut labels = wgpu::Painter::new(&mut gpu);
    while gpu.frame() {
        let time = gpu.time();
        // A matrix among the captures: the gradient, turning.
        let turn = mat2(vec2(time.cos(), time.sin()), vec2(-time.sin(), time.cos()));
        background.fullscreen(&mut gpu, (frag) => {
            let p = turn * (frag.uv - vec2(0.5, 0.5));
            let t = 0.5 + 0.5 * p.y;
            vec4(0.2 + 0.4 * p.x, t * 0.3, 0.4 - t * 0.2, 1.0)
        });

        // A texture and an array among the captures: the grid's cells, each kind its colour.
        let map = grid.texture;
        let colours = [vec4(0.1, 0.1, 0.1, 1.0), vec4(0.9, 0.3, 0.2, 1.0), vec4(0.2, 0.8, 0.3, 1.0), vec4(0.95, 0.9, 0.3, 1.0)];
        let pulse = 0.75 + 0.25 * (time * 3.0).sin();
        let k = gpu.scale;
        tiles.draw(&mut gpu, 40.0 * k, 80.0 * k, 400.0 * k, 400.0 * k, (frag) => {
            let x = (frag.uv.x * 4.0) as i32;
            let y = (frag.uv.y * 4.0) as i32;
            let kind = map.cell(x, y);
            let mut colour = colours[0];
            for i in 0..4 {
                if i == kind {
                    colour = colours[i];
                }
            }
            vec4(colour.r * pulse, colour.g * pulse, colour.b * pulse, 1.0)
        });

        // A `@fragment` function, given its struct of uniforms.
        striped.draw(&mut gpu, 520.0 * k, 80.0 * k, 400.0 * k, 400.0 * k, Stripes {
            time,
            tint: vec4(0.4, 0.8, 1.0, 1.0),
            image: checks,
        });

        let white = vec4(1.0, 1.0, 1.0, 1.0);
        labels.text(&mut gpu, 40.0, 40.0, 24.0, "a closure", white);
        labels.text(&mut gpu, 520.0, 40.0, 24.0, "@fragment fn stripes", white);
        gpu.present();
    }
}

/// A kernel worked out on the GPU and read back: each item twice its input, plus one.
fn checked(gpu: &mut wgpu::Gpu) {
    let mut numbers: [f32; 1000] = [0.0; 1000];
    for i in 0..numbers.len {
        numbers[i] = i as f32;
    }
    let input = gpu.upload(&numbers);
    let output: gpu::Buffer<f32> = gpu.buffer(1000);
    let mut double = wgpu::Kernel::empty();
    double.fill(gpu, &output, (i) => input.get(i) * 2.0 + 1.0);
    let mut back: [f32; 1000] = [0.0; 1000];
    gpu.read(&output, &mut back);
    for i in 0..back.len {
        if back[i] != i as f32 * 2.0 + 1.0 {
            @fail("the GPU's sums are wrong");
        }
    }
    gpu.say("compute: 1000 items worked out on the GPU, all right");
}
