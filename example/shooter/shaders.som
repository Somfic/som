use som::gpu;

/// What the world shader is told each frame.
mod struct View {
    pub pos: Vec2,
    pub dir: Vec2,
    /// The camera plane: from the middle of the screen to its right edge, in the world.
    pub plane: Vec2,
    /// The level, a pixel per cell: red is the kind of wall, 0 for none.
    pub map: gpu::Texture,
    pub time: f32,
    /// From 1 just after the player is hit, down to 0.
    pub hurt: f32,
    /// From 1 just after a shot, down to 0: the muzzle flash lights the halls.
    pub flash: f32,
}

/// What the monster shader is told, for one monster.
mod struct Monster {
    pub pos: Vec2,
    pub dir: Vec2,
    pub plane: Vec2,
    pub map: gpu::Texture,
    pub time: f32,
    pub flash: f32,
    /// How far in front of the camera it is.
    pub depth: f32,
    /// The screen columns it covers, each from 0 to 1 across the screen.
    pub left: f32,
    pub width: f32,
    /// From 1 just after it's shot, down to 0.
    pub pain: f32,
    /// From 0 while alive to 1 when it's gone.
    pub dying: f32,
}

/// Where a ray first meets a wall.
struct Hit {
    /// Distance to it, square to the camera: no fisheye.
    dist: f32,
    /// Its kind, from the map.
    kind: f32,
    /// Where across the wall, from 0 to 1.
    along: f32,
    /// Whether it faces north or south, rather than east or west.
    across: bool,
}

/// The kind of wall in `cell`, 0 for none.
fn wall_kind(map: &gpu::Texture, x: f32, y: f32) -> f32 {
    let c = map.sample(vec2((x + 0.5) / 16.0, (y + 0.5) / 16.0));
    (c.r * 4.0 + 0.5).floor()
}

/// Steps cell by cell from `pos` along `ray` to the first wall (a DDA).
fn raycast(map: &gpu::Texture, pos: Vec2, ray: Vec2) -> Hit {
    let mut cx = pos.x.floor();
    let mut cy = pos.y.floor();
    let dx = if ray.x == 0.0 { 100000.0 } else { (1.0 / ray.x).abs() };
    let dy = if ray.y == 0.0 { 100000.0 } else { (1.0 / ray.y).abs() };
    let sx = if ray.x < 0.0 { -1.0 } else { 1.0 };
    let sy = if ray.y < 0.0 { -1.0 } else { 1.0 };
    let mut tx = if ray.x < 0.0 { (pos.x - cx) * dx } else { (cx + 1.0 - pos.x) * dx };
    let mut ty = if ray.y < 0.0 { (pos.y - cy) * dy } else { (cy + 1.0 - pos.y) * dy };
    let mut across = false;
    let mut kind = 0.0;
    let mut i = 0;
    while i < 48 {
        if tx < ty {
            tx += dx;
            cx += sx;
            across = false;
        } else {
            ty += dy;
            cy += sy;
            across = true;
        }
        kind = wall_kind(map, cx, cy);
        if kind > 0.0 {
            break;
        }
        i += 1;
    }
    let dist = if across { ty - dy } else { tx - dx };
    let at = pos + ray * dist;
    let along = if across { at.x.fract() } else { at.y.fract() };
    Hit { dist, kind, along, across }
}

/// A number from 0 to 1 that looks random, the same each time for `p`.
fn noise(p: Vec2) -> f32 {
    (p.dot(&vec2(12.9898, 78.233)).sin() * 43758.547).fract()
}

/// The colour of a wall of `kind` at (`u`, `v`) across it.
fn wall_color(kind: f32, u: f32, v: f32, time: f32) -> Vec3 {
    if kind < 1.5 {
        // Bricks, every other row half a brick along.
        let row = (v * 6.0).floor();
        let x = u * 3.0 + 0.5 * (row * 0.5).fract() * 2.0;
        let brick = vec2(x.floor(), row);
        let mortar = (x.fract() < 0.06) || ((v * 6.0).fract() < 0.1);
        if mortar {
            return vec3(0.18, 0.15, 0.13);
        }
        let k = 0.75 + 0.25 * noise(brick);
        return vec3(0.55, 0.2, 0.13) * k;
    }
    if kind < 2.5 {
        // Big stone blocks, mottled.
        let block = vec2((u * 2.0).floor(), (v * 3.0).floor());
        let edge = ((u * 2.0).fract() < 0.04) || ((v * 3.0).fract() < 0.05);
        let speck = noise(vec2((u * 40.0).floor(), (v * 40.0).floor()));
        let k = 0.6 + 0.2 * noise(block) + 0.15 * speck;
        if edge {
            return vec3(0.12, 0.12, 0.13);
        }
        return vec3(0.45, 0.45, 0.48) * k;
    }
    // Metal panels with a strip of light that pulses.
    let seam = ((u * 2.0).fract() < 0.03) || (v.fract() < 0.03) || (v > 0.97);
    let glow = 0.5 + 0.5 * (time * 3.0 + u * 6.0).sin();
    if v > 0.45 && v < 0.52 {
        return vec3(0.2, 1.0, 0.5) * (0.6 + 0.6 * glow);
    }
    if seam {
        return vec3(0.08, 0.1, 0.1);
    }
    let k = 0.8 + 0.2 * noise(vec2((u * 2.0).floor(), 1.0));
    vec3(0.25, 0.3, 0.32) * k
}

/// The floor at `spot`: dark tiles; or the ceiling, with a lamp here and there.
fn floor_color(spot: Vec2, below: bool, time: f32) -> Vec3 {
    let tile = vec2(spot.x.floor(), spot.y.floor());
    let f = vec2(spot.x.fract(), spot.y.fract());
    let grout = f.x < 0.04 || f.y < 0.04;
    if below {
        if grout {
            return vec3(0.05, 0.04, 0.04);
        }
        let k = 0.7 + 0.3 * noise(tile);
        return vec3(0.24, 0.2, 0.17) * k;
    }
    let lamp = noise(tile) > 0.8;
    let d = (f - vec2(0.5, 0.5)).length;
    if lamp && d < 0.18 {
        let flicker = 0.85 + 0.15 * (time * 20.0 + tile.x * 7.0).sin();
        return vec3(1.0, 0.85, 0.6) * flicker * 2.0;
    }
    if grout {
        return vec3(0.03, 0.03, 0.03);
    }
    vec3(0.12, 0.11, 0.1)
}

/// How much light reaches something `dist` away: fading into the dark, brighter just after
/// a shot.
fn light(dist: f32, flash: f32) -> f32 {
    let falloff = 1.0 / (1.0 + dist * dist * 0.05);
    falloff * (1.0 + flash * 1.5 / (1.0 + dist * 0.5))
}

/// The halls, for each pixel of the screen: walls, floor and ceiling, by casting a ray
/// through it.
@fragment
mod fn world(frag: Fragment, u: &View) -> Vec4 {
    let ray = u.dir + u.plane * (frag.uv.x * 2.0 - 1.0);
    let hit = raycast(&u.map, u.pos, ray);
    let half = 0.5 / hit.dist;
    let y = frag.uv.y;
    let mut color = vec3(0.0, 0.0, 0.0);
    let mut dist = hit.dist;
    if y > 0.5 - half && y < 0.5 + half {
        let v = (y - (0.5 - half)) / (2.0 * half);
        color = wall_color(hit.kind, hit.along, v, u.time);
        if hit.across {
            color = color * 0.75;
        }
    } else {
        let below = y > 0.5;
        dist = 0.5 / (y - 0.5).abs();
        color = floor_color(u.pos + ray * dist, below, u.time);
    }
    color = color * light(dist, u.flash);
    let red = vec3(0.8, 0.0, 0.0);
    color = color.mix(&red, u.hurt * 0.5);
    vec4(color, 1.0)
}

/// How far `p` is outside a horn from `base` to `tip`, `width` across at its base and
/// coming to a point.
fn horn(p: Vec2, base: Vec2, tip: Vec2, width: f32) -> f32 {
    let along = tip - base;
    let t = ((p - base).dot(&along) / along.dot(&along)).clamp(0.0, 1.0);
    (p - (base + along * t)).length - width * (1.0 - t)
}

/// A monster, for each pixel of its rectangle: a horned, hunched thing with glowing eyes,
/// hidden where a wall is in front of it.
@fragment
mod fn monster(frag: Fragment, u: &Monster) -> Vec4 {
    let column = u.left + frag.uv.x * u.width;
    let ray = u.dir + u.plane * (column * 2.0 - 1.0);
    if raycast(&u.map, u.pos, ray).dist < u.depth {
        return vec4(0.0, 0.0, 0.0, 0.0);
    }
    // From -1 to 1 across, and from -1 at the top to 1 at the bottom; sinking as it dies.
    let bob = 0.04 * (u.time * 9.0).sin() * (1.0 - u.dying);
    let p = vec2(frag.uv.x * 2.0 - 1.0, frag.uv.y * 2.0 - 1.0 - bob - u.dying * 0.9);
    let walk = (u.time * 9.0).sin();

    let body = vec2(p.x, (p.y - 0.05) * 1.3).length - 0.55;
    let head = vec2(p.x, p.y + 0.45).length - 0.3;
    let horn_l = horn(p, vec2(-0.17, -0.62), vec2(-0.42, -0.98), 0.09);
    let horn_r = horn(p, vec2(0.17, -0.62), vec2(0.42, -0.98), 0.09);
    let leg_l = vec2((p.x + 0.25 + walk * 0.05) * 2.5, p.y - 0.8).length - 0.35;
    let leg_r = vec2((p.x - 0.25 - walk * 0.05) * 2.5, p.y - 0.8).length - 0.35;
    let arm_l = vec2((p.x + 0.6) * 1.8, p.y - 0.05 - walk * 0.08).length - 0.3;
    let arm_r = vec2((p.x - 0.6) * 1.8, p.y - 0.05 + walk * 0.08).length - 0.3;
    let shape = body.min(head).min(horn_l).min(horn_r).min(leg_l).min(leg_r).min(arm_l).min(arm_r);
    let alpha = 1.0 - shape.smoothstep(-0.01, 0.02);
    if alpha <= 0.0 || p.y > 1.0 {
        return vec4(0.0, 0.0, 0.0, 0.0);
    }

    let skin = vec3(0.5, 0.11, 0.07) * (0.75 + 0.25 * noise(vec2((p.x * 12.0).floor(), (p.y * 12.0).floor())));
    let bone = vec3(0.85, 0.8, 0.65);
    let mut color = if horn_l < 0.0 || horn_r < 0.0 { bone } else { skin };
    // Darker towards its edges, as if lit from the front.
    color = color * (0.6 + 0.4 * (-shape * 6.0).clamp(0.0, 1.0));

    // Eyes under brows that slant down to the middle: it's angry.
    let eye_l = vec2(p.x + 0.12, p.y + 0.5).length;
    let eye_r = vec2(p.x - 0.12, p.y + 0.5).length;
    let brow = p.y + 0.5 < 0.5 * (0.16 - p.x.abs()) - 0.02;
    // A wide mouth, with a row of teeth along its top and bottom.
    let mouth = vec2(p.x * 0.45, (p.y + 0.3) * 2.2).length;
    let teeth = (p.x * 14.0).fract() < 0.6 && ((p.y + 0.3).abs() > 0.025);
    let lit = light(u.depth, u.flash);
    color = color * lit;
    if (eye_l < 0.065 || eye_r < 0.065) && !brow {
        color = vec3(1.0, 0.55, 0.1) * (1.0 - u.dying) * 1.5;
    } else if mouth < 0.11 {
        color = if teeth { bone * lit } else { vec3(0.08, 0.0, 0.0) };
    }
    let white = vec3(1.0, 1.0, 1.0);
    color = color.mix(&white, u.pain * 0.7);
    vec4(color, alpha * (1.0 - u.dying * 0.6))
}
