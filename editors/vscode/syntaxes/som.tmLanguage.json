{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Som",
  "scopeName": "source.som",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#function-definition" },
    { "include": "#struct-definition" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.som",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.som",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.som",
              "match": "\\\\(x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\}|.)"
            },
            {
              "name": "constant.character.escape.som",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.som",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.som" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.som" } },
              "contentName": "meta.embedded.line.som",
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.som",
          "match": "\\b(if|else|loop|while|break|continue|return|for|in|use|as|match)\\b"
        },
        {
          "name": "keyword.other.som",
          "match": "\\b(fn|prop|extern|struct|enum|impl|trait|type|const|let|mut|out|self|pub|mod)\\b"
        },
        {
          "name": "constant.language.boolean.som",
          "match": "\\b(true|false|none)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.som",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|string|cstr)\\b"
        },
        {
          "comment": "A constant's name: RED, MAX_LEN (not a lone T, a type parameter)",
          "name": "variable.other.constant.som",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "comment": "Self, the type an impl block is for",
          "name": "entity.name.type.struct.som",
          "match": "\\bSelf\\b"
        },
        {
          "comment": "A built-in, like @unreachable: coloured like a type",
          "name": "entity.name.type.struct.som",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "comment": "Raw pointer type after -> or :",
          "match": "(?<=->\\s)\\*|(?<=->)\\*|(?<=:\\s)\\*|(?<=:)\\*",
          "name": "entity.name.type.primitive.som"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fn|prop)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.som" },
            "2": { "name": "entity.name.function.som" }
          }
        }
      ]
    },
    "struct-definition": {
      "patterns": [
        {
          "match": "\\b(struct|enum|trait)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.som" },
            "2": { "name": "entity.name.type.struct.som" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.som",
          "match": "\\b[0-9]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.som",
          "match": "\\b(?:0x[0-9a-fA-F_]+|0b[01_]+|[0-9][0-9_]*)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.som",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.som",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arrow.som",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.som",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.som",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.borrow.som",
          "match": "&"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.som",
          "match": "::|[;:,.]"
        }
      ]
    }
  }
}
