/// Gives values one at a time: each `next` is the next one, or `none` once there are no more.
/// `for x in it` goes through them.
pub trait Iterator {
    /// What it gives.
    type Item;

    fn next(self: &mut Self) -> Item?;
}

/// Can be gone through with `for x in &value`, which goes through the iterator `iter` makes:
/// it lends the values, or copies them if they copy.
pub trait IterRef {
    /// The iterator `iter` makes.
    type Iter;

    fn iter(self: &Self) -> Iter;
}

/// Can be gone through with `for x in &mut value`, which goes through the iterator `iter_mut`
/// makes: it lends the values to change.
pub trait IterMut {
    /// The iterator `iter_mut` makes.
    type Iter;

    fn iter_mut(self: &mut Self) -> Iter;
}

/// Can be given up to `for x in value`, which goes through the iterator `into_iter` makes:
/// it owns the values, and gives each away in turn.
pub trait IterOwned {
    /// The iterator `into_iter` makes.
    type Iter;

    fn into_iter(self: Self) -> Iter;
}

/// Holds a value that's never dropped on its own: whatever holds the `Manual` drops what
/// needs dropping. An array's iterator holds the array in one, and drops only the elements it
/// hasn't given away.
pub struct Manual<T> {
    pub value: T,
}

/// Can be made from a `T`, which becomes one wherever it's given and a `Self` is expected:
/// `let list: List<i32> = [1, 2, 3]` is `List::from([1, 2, 3])`.
pub trait From<T> {
    fn from(value: T) -> Self;
}

/// `a + b`: `Other` is what's on the right, `Output` what comes out. Both are `Self`
/// unless an implementation says: `impl Add<f32> for Vector`.
pub trait Add<Other = Self, Output = Self> {
    fn add(self: &Self, other: &Other) -> Output;
}

/// `a - b`: `Other` is what's on the right, `Output` what comes out. Both are `Self`
/// unless an implementation says: `impl Subtract<f32> for Vector`.
pub trait Subtract<Other = Self, Output = Self> {
    fn subtract(self: &Self, other: &Other) -> Output;
}

/// `a * b`: `Other` is what's on the right, `Output` what comes out. Both are `Self`
/// unless an implementation says: `impl Multiply<f32> for Vector`.
pub trait Multiply<Other = Self, Output = Self> {
    fn multiply(self: &Self, other: &Other) -> Output;
}

/// `a / b`: `Other` is what's on the right, `Output` what comes out. Both are `Self`
/// unless an implementation says: `impl Divide<f32> for Vector`.
pub trait Divide<Other = Self, Output = Self> {
    fn divide(self: &Self, other: &Other) -> Output;
}

/// Which of two values comes first. The language relies on the variants' order.
pub enum Ordering { Less, Equal, Greater }

/// Can be compared with `<`, `>`, `<=` and `>=`: `a < b` is `a.compare(&b) == Less`.
pub trait Compare {
    fn compare(self: &Self, other: &Self) -> Ordering;
}

/// Copied rather than moved: using a value leaves it usable. Numbers, `bool`, pointers and
/// `&` references are; a struct is if it implements this, and everything in it is too.
pub trait Copy {}

pub trait Index: Sized {
    type Item;

    @where index < self.len, "a position in it"
    fn at(self: &Self, index: usize) -> &Item;

    fn get(self: &Self, index: usize) -> &Item? {
        if index < self.len {
            return self.at(index);
        }
        none
    }
}

pub trait IndexMut: Index {
    @where index < self.len, "a position in it"
    fn at_mut(self: &mut Self, index: usize) -> &mut Self::Item;

    fn get_mut(self: &mut Self, index: usize) -> &mut Self::Item? {
        if index < self.len {
            return self.at_mut(index);
        }
        none
    }
}

pub trait Sized {
    prop len: usize;
}

/// Shown as text: what `{x}` in `"total: {x}"` writes. Measured first, so the text it's
/// written into is made once, at its full length.
pub trait Display {
    /// How many bytes its text takes.
    prop display_len: usize;

    /// Writes its text at `to`, which has room for `display_len` bytes. It may write a zero
    /// byte after them, which what's written next covers.
    fn display(self: &Self, to: *u8);

    /// Its text, as a `string` of its own: `"{self}"`.
    fn to_string(self: &Self) -> string = "{self}";
}

/// Copied by calling `share` rather than moved: using a value leaves it usable, and the
/// copy is whatever `share` gives. For a value that keeps count of its copies, as a
/// reference-counted pointer does: `share` counts one more, and `Drop` one fewer.
/// Copies happen without it being written, so `share` should be cheap.
pub trait Share {
    fn share(self: &Self) -> Self;
}

/// Drops `value` now, rather than when its scope ends: moving it here ends it.
pub fn drop<T>(value: T) {}

/// Cleans up after a value when it's done with: when its variable's scope ends, it's
/// replaced, or the temporary holding it isn't needed any more. Not when it's been moved.
/// What it holds is dropped after, by itself.
pub trait Drop {
    fn drop(self: &mut Self);
}

/// Can be compared with `==` and `!=`.
pub trait Eq {
    fn eq(self: &Self, other: &Self) -> bool;
}
