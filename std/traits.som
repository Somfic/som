/// Gives values one at a time: each `next` is the next one, or `none` once there are no more.
/// `for x in it` goes through them.
trait Iterator {
    /// What it gives.
    type Item;

    fn next(self: &mut Self) -> Item?;
}

/// Can be gone through with `for`, which goes through the iterator `iter` makes.
trait Iterable {
    /// The iterator `iter` makes.
    type Iter;

    fn iter(self: &Self) -> Iter;
}

/// Can be made from a `T`, which becomes one wherever it's given and a `Self` is expected:
/// `let list: List<i32> = [1, 2, 3]` is `List::from([1, 2, 3])`.
trait From<T> {
    fn from(value: T) -> Self;
}

/// `a + b`.
trait Add {
    fn add(self: &Self, other: &Self) -> Self;
}

/// `a - b`.
trait Subtract {
    fn subtract(self: &Self, other: &Self) -> Self;
}

/// `a * b`.
trait Multiply {
    fn multiply(self: &Self, other: &Self) -> Self;
}

/// `a / b`.
trait Divide {
    fn divide(self: &Self, other: &Self) -> Self;
}

/// Which of two values comes first. The language relies on the variants' order.
enum Ordering { Less, Equal, Greater }

/// Can be compared with `<`, `>`, `<=` and `>=`: `a < b` is `a.compare(&b) == Less`.
trait Compare {
    fn compare(self: &Self, other: &Self) -> Ordering;
}

/// Copied rather than moved: using a value leaves it usable. Numbers, `bool`, pointers and
/// `&` references are; a struct is if it implements this, and everything in it is too.
trait Copy {}

/// Drops `value` now, rather than when its scope ends: moving it here ends it.
fn drop<T>(value: T) {}

/// Cleans up after a value when it's done with: when its variable's scope ends, it's
/// replaced, or the temporary holding it isn't needed any more. Not when it's been moved.
/// What it holds is dropped after, by itself.
trait Drop {
    fn drop(self: &mut Self);
}

/// Can be compared with `==` and `!=`.
trait Eq {
    fn eq(self: &Self, other: &Self) -> bool;
}
