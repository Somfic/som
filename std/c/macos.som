/// A structure representing a resource limit.  The address of an instance
/// of this structure is the second parameter to getrlimit()/setrlimit().
pub struct Rlimit {
    /// current (soft) limit
    pub rlim_cur: u64,
    /// maximum value for rlim_cur
    pub rlim_max: u64,
}

/// A structure representing an accounting of resource utilization.  The
/// address of an instance of this structure is the second parameter to
/// getrusage().
///
/// Note: All values other than ru_utime and ru_stime are implementaiton
///       defined and subject to change in a future release.  Their use
///       is discouraged for standards compliant programs.
pub struct Rusage {
    /// user time used (PL)
    pub ru_utime: Timeval,
    /// system time used (PL)
    pub ru_stime: Timeval,
    /// max resident set size (PL)
    pub ru_maxrss: i64,
    /// integral shared memory size (NU)
    pub ru_ixrss: i64,
    /// integral unshared data (NU)
    pub ru_idrss: i64,
    /// integral unshared stack (NU)
    pub ru_isrss: i64,
    /// page reclaims (NU)
    pub ru_minflt: i64,
    /// page faults (NU)
    pub ru_majflt: i64,
    /// swaps (NU)
    pub ru_nswap: i64,
    /// block input operations (atomic)
    pub ru_inblock: i64,
    /// block output operations (atomic)
    pub ru_oublock: i64,
    /// messages sent (atomic)
    pub ru_msgsnd: i64,
    /// messages received (atomic)
    pub ru_msgrcv: i64,
    /// signals received (atomic)
    pub ru_nsignals: i64,
    /// voluntary context switches (atomic)
    pub ru_nvcsw: i64,
    /// involuntary "
    pub ru_nivcsw: i64,
}

pub struct Timespec {
    pub tv_sec: i64,
    pub tv_nsec: i64,
}

pub struct Timeval {
    /// seconds
    pub tv_sec: i64,
    /// and microseconds
    pub tv_usec: i32,
}

pub struct Tm {
    /// seconds after the minute [0-60]
    pub tm_sec: i32,
    /// minutes after the hour [0-59]
    pub tm_min: i32,
    /// hours since midnight [0-23]
    pub tm_hour: i32,
    /// day of the month [1-31]
    pub tm_mday: i32,
    /// months since January [0-11]
    pub tm_mon: i32,
    /// years since 1900
    pub tm_year: i32,
    /// days since Sunday [0-6]
    pub tm_wday: i32,
    /// days since January 1 [0-365]
    pub tm_yday: i32,
    /// Daylight Savings Time flag
    pub tm_isdst: i32,
    /// offset from UTC in seconds
    pub tm_gmtoff: i64,
    /// timezone abbreviation
    pub tm_zone: *,
}

