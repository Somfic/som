    pub fn sigfillset(__set: SigsetT) -> i32;
    /// Add SIGNO to SET.
    pub fn sigaddset(__set: SigsetT, __signo: i32) -> i32;
    /// Remove SIGNO from SET.
    pub fn sigdelset(__set: SigsetT, __signo: i32) -> i32;
    /// Return 1 if SIGNO is in SET, 0 if not.
    pub fn sigismember(__set: SigsetT, __signo: i32) -> i32;
    /// Get and/or change the set of blocked signals.
    pub fn sigprocmask(__how: i32, __set: SigsetT, __oset: SigsetT) -> i32;
    /// Change the set of blocked signals to SET,
    /// wait until a signal arrives, and restore the set of blocked signals.
    ///
    /// This function is a cancellation point and therefore not marked with
    /// __THROW.
    pub fn sigsuspend(__set: SigsetT) -> i32;
    /// Get and/or set the action for signal SIG.
    pub fn sigaction(__sig: i32, __act: *, __oact: *) -> i32;
    /// Put in SET all signals that are blocked and waiting to be delivered.
    pub fn sigpending(__set: SigsetT) -> i32;
    /// Select any of pending signals from SET or wait for any to arrive.
    ///
    /// This function is a cancellation point and therefore not marked with
    /// __THROW.
    pub fn sigwait(__set: SigsetT, __sig: &mut i32) -> i32;
    /// Select any of pending signals from SET and place information in INFO.
    ///
    /// This function is a cancellation point and therefore not marked with
    /// __THROW.
    pub fn sigwaitinfo(__set: SigsetT, __info: SiginfoT) -> i32;
    pub fn sigtimedwait(__set: SigsetT, __info: SiginfoT, __timeout: &Timespec) -> i32;
    /// Restore the state saved in SCP.
    pub fn sigreturn(__scp: *) -> i32;
    /// If INTERRUPT is nonzero, make signal SIG interrupt system calls
    /// (causing them to fail with EINTR); if INTERRUPT is zero, make system
    /// calls be restarted after signal SIG.
    pub fn siginterrupt(__sig: i32, __interrupt: i32) -> i32;
    /// Alternate signal handler stack interface.
    /// This interface should always be preferred over `sigstack'.
    pub fn sigaltstack(__ss: StackT, __oss: StackT) -> i32;
    /// Run signals handlers on the stack specified by SS (if not NULL).
    /// If OSS is not NULL, it is filled in with the old signal stack status.
    /// This interface is obsolete and on many platform not implemented.
    pub fn sigstack(__ss: &mut Sigstack, __oss: &mut Sigstack) -> i32;
    /// Modify the signal mask for the calling thread.  The arguments have
    /// the same meaning as for sigprocmask(2).
    pub fn pthread_sigmask(__how: i32, __newmask: SigsetT, __oldmask: SigsetT) -> i32;
    /// Send signal SIGNO to the given thread.
    pub fn pthread_kill(__threadid: u64, __signo: i32) -> i32;
    /// Wait for a child to die.  When one does, put its status in *STAT_LOC
    /// and return its process ID.  For errors, return (pid_t) -1.
    ///
    /// This function is a cancellation point and therefore not marked with
    /// __THROW.
    pub fn wait(__stat_loc: &mut i32) -> i32;
    /// Wait for a child matching PID to die.
    /// If PID is greater than 0, match any process whose process ID is PID.
    /// If PID is (pid_t) -1, match any process.
    /// If PID is (pid_t) 0, match any process with the
    /// same process group as the current process.
    /// If PID is less than -1, match any process whose
    /// process group is the absolute value of PID.
    /// If the WNOHANG bit is set in OPTIONS, and that child
    /// is not already dead, return (pid_t) 0.  If successful,
    /// return PID and store the dead child's status in STAT_LOC.
    /// Return (pid_t) -1 for errors.  If the WUNTRACED bit is
    /// set in OPTIONS, return status for stopped children; otherwise don't.
    ///
    /// This function is a cancellation point and therefore not marked with
    /// __THROW.
    pub fn waitpid(__pid: i32, __stat_loc: &mut i32, __options: i32) -> i32;
    /// Wait for a childing matching IDTYPE and ID to change the status and
    /// place appropriate information in *INFOP.
    /// If IDTYPE is P_PID, match any process whose process ID is ID.
    /// If IDTYPE is P_PGID, match any process whose process group is ID.
    /// If IDTYPE is P_ALL, match any process.
    /// If the WNOHANG bit is set in OPTIONS, and that child
    /// is not already dead, clear *INFOP and return 0.  If successful, store
    /// exit code and status in *INFOP.
    ///
    /// This function is a cancellation point and therefore not marked with
    /// __THROW.
    pub fn waitid(__idtype: i32, __id: u32, __infop: SiginfoT, __options: i32) -> i32;
    pub fn wait3(__stat_loc: &mut i32, __options: i32, __usage: Rusage) -> i32;
    /// PID is like waitpid.  Other args are like wait3.
    pub fn wait4(__pid: i32, __stat_loc: &mut i32, __options: i32, __usage: Rusage) -> i32;
    /// The error code set by various library functions.
    pub fn __errno_location() -> *;
}
