extern "c";

impl f32 {
    pub fn pow(self, power: f32) {
        c::powf(self, power)
    }

    pub fn sqrt(self) {
        c::sqrtf(self)
    }
}


impl f64 {
    pub fn pow(self, power: f64) {
        c::pow(self, power)
    }

    pub fn sqrt(self) {
        c::sqrt(self)
    }
}

impl usize {
    pub fn smallest(self, other: usize) -> usize {
        self if self <= other else other
    }

     pub fn biggest(self, other: usize) -> usize {
        self if self >= other else other
    }
}
