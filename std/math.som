use som::c;
use som::gpu;

/// Each is gpu's own function in a shader (`@if GPU`), and C's everywhere else.
impl f32 {
    pub @const PI = c::M_PI as f32;
    pub @const HALF_PI = PI / 2.0;

    pub fn pow(self, power: f32) -> f32 {
        @if GPU { return gpu::pow(self, power); } else { return c::powf(self, power); }
    }

    pub fn sqrt(self) -> f32 {
        @if GPU { return gpu::sqrt(self); } else { return c::sqrtf(self); }
    }

    // the trigonometric sine
    pub fn sin(self) -> f32 {
        @if GPU { return gpu::sin(self); } else { return c::sinf(self); }
    }

    // the hyperbolic sine
    pub fn sinh(self) -> f32 {
        @if GPU { return gpu::sinh(self); } else { return c::sinhf(self); }
    }

    // the trigonometric cosine
    pub fn cos(self) -> f32 {
        @if GPU { return gpu::cos(self); } else { return c::cosf(self); }
    }

    // the hyperbolic cosine
    pub fn cosh(self) -> f32 {
        @if GPU { return gpu::cosh(self); } else { return c::coshf(self); }
    }

     // the trigonometric tangent
    pub fn tan(self) -> f32 {
        @if GPU { return gpu::tan(self); } else { return c::tanf(self); }
    }

    // the hyperbolic tangent
    pub fn tanh(self) -> f32 {
        @if GPU { return gpu::tanh(self); } else { return c::tanhf(self); }
    }

    /// The angle from the x axis to the point `(x, y)`, from -π to π.
    pub fn atan2(y: f32, x: f32) -> f32 {
        @if GPU { return gpu::atan2(y, x); } else { return c::atan2f(y, x); }
    }

    /// e to the power of `self`.
    pub fn exp(self) -> f32 {
        @if GPU { return gpu::exp(self); } else { return c::expf(self); }
    }

    /// The natural logarithm.
    pub fn ln(self) -> f32 {
        @if GPU { return gpu::log(self); } else { return c::logf(self); }
    }

    pub fn log2(self) -> f32 {
        @if GPU { return gpu::log2(self); } else { return c::log2f(self); }
    }

    /// Without its sign.
    pub fn abs(self) -> f32 {
        @if GPU { return gpu::abs(self); } else { return c::fabsf(self); }
    }

    /// The nearest whole number at or below it.
    pub fn floor(self) -> f32 {
        @if GPU { return gpu::floor(self); } else { return c::floorf(self); }
    }

    /// The nearest whole number at or above it.
    pub fn ceil(self) -> f32 {
        @if GPU { return gpu::ceil(self); } else { return c::ceilf(self); }
    }

    /// The nearest whole number; halfway, the one further from zero.
    pub fn round(self) -> f32 {
        // gpu's `round` goes to the even one, halfway.
        @if GPU {
            return gpu::sign(self) * gpu::floor(gpu::abs(self) + 0.5);
        } else {
            return c::roundf(self);
        }
    }

    /// The whole number part: towards zero.
    pub fn trunc(self) -> f32 {
        @if GPU { return gpu::trunc(self); } else { return c::truncf(self); }
    }

    /// What's left after its `floor`: from 0 up to 1.
    pub fn fract(self) -> f32 {
        self - self.floor()
    }

    pub fn min(self, other: f32) -> f32 {
        @if GPU { return gpu::min(self, other); } else { return c::fminf(self, other); }
    }

    pub fn max(self, other: f32) -> f32 {
        @if GPU { return gpu::max(self, other); } else { return c::fmaxf(self, other); }
    }

    /// Kept from `low` to `high`.
    pub fn clamp(self, low: f32, high: f32) -> f32 {
        self.max(low).min(high)
    }

    /// From `self` to `to` by `t`: `self` at 0, `to` at 1.
    pub fn mix(self, to: f32, t: f32) -> f32 {
        self + (to - self) * t
    }

    /// 0 below `edge`, 1 from it on.
    pub fn step(self, edge: f32) -> f32 {
        if self < edge { 0.0 } else { 1.0 }
    }

    /// From 0 at `low` to 1 at `high`, smoothly: no sudden change at either end.
    pub fn smoothstep(self, low: f32, high: f32) -> f32 {
        let t = ((self - low) / (high - low)).clamp(0.0, 1.0);
        t * t * (3.0 - 2.0 * t)
    }
}


impl f64 {
    pub @const PI = c::M_PI;
    pub @const HALF_PI = PI / 2.0;

    pub fn pow(self, power: f64) -> f64 {
        c::pow(self, power)
    }

    pub fn sqrt(self) -> f64 {
        c::sqrt(self)
    }


    // the trigonometric sine
    pub fn sin(rads: f64) -> f64 {
        c::sin(rads)
    }

    // the hyperbolic sine
    pub fn sinh(rads: f64) -> f64 {
        c::sinh(rads)
    }

    // the trigonometric cosine
    pub fn cos(rads: f64) -> f64 {
        c::cos(rads)
    }

    // the hyperbolic cosine
    pub fn cosh(rads: f64) -> f64 {
        c::cosh(rads)
    }

     // the trigonometric tangent
    pub fn tan(rads: f64) -> f64 {
        c::tan(rads)
    }

    // the hyperbolic tangent
    pub fn tanh(rads: f64) -> f64 {
        c::tanh(rads)
    }
}

impl usize {
    pub fn smallest(self, other: usize) -> usize {
        self if self <= other else other
    }

     pub fn biggest(self, other: usize) -> usize {
        self if self >= other else other
    }
}
