extern "c";
use som::mem;

pub struct Failure {
    pub message: string,
    pub at: Location,
    pub unreachable: bool,
}

/// Where something happened in the program. A standard-library function that can fail, like
/// `assert`, is told where it was called, and fails there.
pub struct Location {
    pub file: cstr,
    pub line: u32,
    pub column: u32,
    pub function: cstr,
}

impl Copy for Location {}

@on fail pub fn on_fail(failure: &Failure) {
    let at = "{failure.at.file}:{failure.at.line}:{failure.at.column} in {failure.at.function}";
    let text = "reached @unreachable at {at}" if failure.unreachable else "failed at {at}: {failure.message}";
    c::printf("%s\n", text.c_str);
}

fn halt() {
    c::fflush(null());
    c::abort();
}

pub fn assert_eq<T: Eq>(actual: T, expected: T) {
    assert_eq(actual, expected, "unmet assertion");
}

pub fn assert_eq<T: Eq>(actual: T, expected: T, error_message: string) {
    if actual != expected @fail(error_message);
}

pub fn assert(predicate: bool) {
    assert(predicate, "unmet assertion");
}

pub fn assert(predicate: bool, error_message: string) {
    if !predicate @fail(error_message);
}
