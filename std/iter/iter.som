pub trait Iterator {
    type Item;

    pub fn next(self: &mut Self) -> Item?;
}

/// for x in &collection
pub trait IterRef {
    type Iter;

    pub fn iter(self: &Self) -> Iter;
}

/// for x in &mut collection
pub trait IterMut {
    type Iter;

    pub fn iter_mut(self: &mut Self) -> Iter;
}

/// for x in collection
pub trait IterOwned {
    type Iter;

    pub fn into_iter(self: Self) -> Iter;
}
