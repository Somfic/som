/// Anything with `Index` can be gone through with `for x in &value`
impl<C: Index> IterRef for C {
    type Iter = IndexIter<C>;

    fn iter(&self) -> IndexIter<C> = IndexIter::of(self);
}

/// Anything with `IndexMut` can be gone through with `for x in &mut value`.
impl<C: IndexMut> IterMut for C {
    type Iter = IndexIterMut<C>;

    fn iter_mut(&mut self) -> IndexIterMut<C> = IndexIterMut::of(self);
}

pub struct IndexIter<C: Index> {
    of: &C,
    index: usize,
}

impl<C: Index> IndexIter<C> {
    pub fn of(values: &C) -> Self = IndexIter { of: values, index: 0 };
}

impl<C: Index> Iterator for IndexIter<C> {
    type Item = &C::Item;

    fn next(&mut self) -> &C::Item? {
        let item = .of.get(.index);
        .index = .index + 1;
        item
    }
}

pub struct IndexIterMut<C: IndexMut> {
    of: &mut C,
    index: usize,
}

impl<C: IndexMut> IndexIterMut<C> {
    pub fn of(values: &mut C) -> Self = IndexIterMut { of: values, index: 0 };
}

impl<C: IndexMut> Iterator for IndexIterMut<C> {
    type Item = &mut C::Item;

    fn next(&mut self) -> &mut C::Item? {
        let item = .of.get_mut(.index);
        .index = .index + 1;
        item
    }
}
