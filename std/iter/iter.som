pub trait Iterator {
    type Item;

    fn next(self: &mut Self) -> Item?;
}

/// for x in &collection
pub trait IterRef {
    type Iter;

    fn iter(self: &Self) -> Iter;
}

/// for x in &mut collection
pub trait IterMut {
    type Iter;

    fn iter_mut(self: &mut Self) -> Iter;
}

/// for x in collection
pub trait IterOwned {
    type Iter;

    fn into_iter(self: Self) -> Iter;
}
