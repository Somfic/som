use som::c;

// What `som test` runs. The compiler writes the loop: for each `@test`, `test_start`, and
// where that's true, the test, then `test_passed`; then `test_summary` is the exit code.

/// Starts the test `name`, at `at`, in a child process of its own, so a failure ends only
/// that test. True in the child, which runs it. Here it's false, once the child is done,
/// and `failed` counts the test if the child didn't pass it.
///
/// Windows has no `fork`: there each test runs in this process, and one that fails stops
/// the rest.
fn test_start(failed: &mut i32, name: string, at: Location) -> bool {
    @if WINDOWS {
        c::printf("%s ... ", name.c_str);
        return true;
    } else {
        return forked(failed, name, at);
    }
}

/// `test_start` where there's `fork`: the test runs in a child process.
fn forked(failed: &mut i32, name: string, at: Location) -> bool {
    // What's printed so far would otherwise be printed by the child too.
    c::fflush(null());
    let child = c::fork();
    if child == 0 {
        return true;
    }
    if child < 0 {
        c::printf("could not start the test\n");
        return finished(failed, name, at, 1);
    }
    let mut status = 0;
    c::waitpid(child, &mut status, 0);
    // What stopped it, as `waitpid` says: a signal in the low 7 bits, or else the exit code
    // in the next 8.
    let signal = status & 127;
    if signal == ABORTED {
        // `@fail` or `@unreachable`: it said why, then stopped with `abort`.
    } else if signal != 0 {
        let why = c::strsignal(signal) as cstr;
        let line = "crashed: {why}";
        c::printf("%s\n", line.c_str);
    } else if status != 0 {
        let line = "exited with code {(status >> 8) & 255}";
        c::printf("%s\n", line.c_str);
    }
    return finished(failed, name, at, status);
}

/// `SIGABRT`, which `abort` stops a process with.
@const ABORTED = 6;

/// Says whether the test `name` passed, by how its process ended: `status`, `0` if it did.
fn finished(failed: &mut i32, name: string, at: Location, status: i32) -> bool {
    if status == 0 {
        c::printf("ok      %s\n", name.c_str);
    } else {
        *failed = *failed + 1;
        let line = "FAILED  {name} ({at.file}:{at.line})";
        c::printf("%s\n", line.c_str);
    }
    false
}

/// The test returned: it passed. The child it ran in is done.
fn test_passed() {
    @if WINDOWS {
        c::printf("ok\n");
    } else {
        c::fflush(null());
        c::exit(0);
    }
}

/// How many passed and how many failed; the exit code is 1 if any failed.
fn test_summary(failed: i32, total: i32) -> i32 {
    let line = "{total - failed} passed, {failed} failed";
    c::printf("\n%s\n", line.c_str);
    if failed > 0 {
        return 1;
    }
    0
}
