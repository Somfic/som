extern "c";

pub fn get_env(name: string) -> string? {
    let value = c::getenv(name.c_str);

    if value == som::mem::null() {
        return none;
    }

    string::from_c(value as cstr)
}

pub fn get_env(name: string) -> bool {
    match get_env(name) {
        "true" => true,
        "TRUE" => true,
        "1" => true,
        "yes" => true,
        "YES" => true,
        _ => false,
    }
}

pub fn set_env(name: string, value: string) {
    c::setenv(name.c_str, value.c_str, 1);
}

pub fn clear_env(name: string) {
    c::unsetenv(name.c_str);
}
