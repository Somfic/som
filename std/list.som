use som::mem;
use som::iter;

pub struct List<T> {
    mem: Alloc<T>,
    len: usize,
}

impl<T> List<T> {
    pub prop len = .len;
    pub prop is_empty = .len == 0;
    prop capacity = .mem.capacity;
    prop is_full = .len == .capacity;

    pub fn empty() -> Self {
        List { mem: Alloc::empty(), len: 0 }
    }

    pub fn with_capacity(capacity: usize) -> Self {
        List { mem: Alloc::with_capacity(capacity), len: 0 }
    }

    pub fn push(&mut self, value: T) {
        if .is_full self.mem.grow();
        .mem.put_at(.len, value);
        .len = .len + 1;
    }

    pub fn pop(&mut self) -> T? {
        if .len == 0 {
            return none;
        }
        .len = .len - 1;
        .mem.take_at(.len)
    }

    pub prop slice = .mem.slice(.len);

    pub fn as_slice(&self) -> &[T] {
        .mem.slice(.len)
    }

    pub fn as_slice_mut(&mut self) -> &mut [T] {
        .mem.slice_mut(.len)
    }

    pub fn clear(&mut self) {
        for i in 0..self.len {
            drop(.mem.take_at(i));
        }
        .len = 0;
    }
}

impl<T: Copy> List<T> {
    pub fn of(values: &[T]) -> Self {
        let mut list: List<T> = List::with_capacity(values.len);
        for value in values {
            list.push(value);
        }
        list
    }
}

impl<T> Index for List<T> {
    type Item = T;

    prop len: usize = .len;

    fn at(&self, index: usize) -> &T = .mem.at(index);
}

impl<T> IndexMut for List<T> {
    fn at_mut(&mut self, index: usize) -> &mut T = .mem.at_mut(index);
}

impl<T> Drop for List<T> {
    fn drop(&mut self) {
        .clear();
    }
}

impl<T: Copy, N: usize> From<[T; N]> for List<T> {
    fn from(items: [T; N]) -> List<T> {
        let mut list: List<T> = List::with_capacity(items.len);
        for item in items { list.push(item); }
        list
    }
}

impl<T: Copy> From<&[T]> for List<T> {
     fn from(items: &[T]) -> List<T> {
        let mut list: List<T> = List::with_capacity(items.len);
        for item in items { list.push(item); }
        list
    }
}

impl<T> IterRef for List<T> {
    type Iter = iter::IndexIter<List<T>>;

    fn iter(&self) -> iter::IndexIter<List<T>> = iter::IndexIter::of(self);
}

impl<T> IterMut for List<T> {
    type Iter = iter::IndexIterMut<List<T>>;

    fn iter_mut(&mut self) -> iter::IndexIterMut<List<T>> = iter::IndexIterMut::of(self);
}

impl<T> IterOwned for List<T> {
    type Iter = ListIntoIter<T>;

    fn into_iter(self) -> ListIntoIter<T> {
        ListIntoIter { list: self, next: 0 }
    }
}

pub struct ListIntoIter<T> {
    list: List<T>,
    next: usize,
}

impl<T> Iterator for ListIntoIter<T> {
    type Item = T;

    fn next(&mut self) -> T? {
        if .next == .list.len {
            return none;
        }
        let value: T = .list.mem.take_at(.next);
        .next = .next + 1;
        value
    }
}

impl<T> Drop for ListIntoIter<T> {
    /// Drops the values it hasn't given away. The list then holds none, so dropping it only
    /// gives the room back.
    fn drop(&mut self) {
        for i in .next..self.list.len {
            drop(.list.mem.take_at(i));
        }
        .list.len = 0;
    }
}
