// A memory allocation for T
struct Alloc<T> {
    ptr: *T,
    size: usize
}

impl<T> Alloc<T> {
    fn new() -> Self {
        Alloc { ptr: null<T>(), size: 0 }
    }

    fn new(size: usize) -> Self {
        let mut ptr = null<T>();
        ptr.resize(size);
        Alloc { ptr, size }
    }

    fn resize(&mut self, size: usize) {
        self.ptr.resize(size);
        self.size = size;
    }

    fn write(&mut self, at: usize, value: T) {
        self.ptr.write(at, value)
    }

    fn read(&mut self, at: usize) -> T {
        self.ptr.read(at)
    }

    fn at(&self, at: usize) -> &T {
        self.ptr.at(at)
    }

    fn at(&mut self, at: usize) -> &mut T {
        self.ptr.at_mut(at)
    }

    fn view(&self, len: usize) -> &[T] {
        self.ptr.view(len)
    }

    fn view(&mut self, len: usize) -> &mut [T] {
        self.ptr.view_mut(len)
    }
}

impl<T> Drop for Alloc<T> {
    fn drop(self: &mut Alloc<T>) {
        self.ptr.free();
    }
}
