/// Room for `capacity` `T`s. It doesn't know which slots hold a value: its owner does, and
/// drops them before it goes, since dropping an `Alloc` only gives the memory back.
pub struct Alloc<T> {
    ptr: *T,
    count: usize
}

impl<T> Alloc<T> {
    pub fn empty() -> Self {

        Alloc { ptr: null<T>(), count: 0 }
    }

    pub prop capacity = .count;

    pub fn with_capacity(capacity: usize) -> Self {
        let mut ptr = null<T>();
        ptr.resize(capacity);
        Alloc { ptr, count: capacity }
    }

    pub fn resize(&mut self, size: usize) {
        self.ptr.resize(size);
        self.count = size;
    }

    /// Moves `value` into an empty slot. Whatever was there isn't dropped.
    pub fn put_at(&mut self, index: usize, value: T) {
        self.ptr.put(index, value);
    }

    /// Moves the value out, leaving the slot empty.
    pub fn take_at(&mut self, index: usize) -> T {
        self.ptr.take(index)
    }

    /// Borrows the value, which stays in its slot.
    pub fn at(&self, index: usize) -> &T {
        self.ptr.at(index)
    }

    pub fn at_mut(&mut self, index: usize) -> &mut T {
        self.ptr.at_mut(index)
    }

    /// The first `len` slots, which must all hold values.
    pub fn slice(&self, len: usize) -> &[T] {
        self.ptr.view(len)
    }

    pub fn slice_mut(&mut self, len: usize) -> &mut [T] {
        self.ptr.view_mut(len)
    }
}

impl<T> Drop for Alloc<T> {
    fn drop(self: &mut Alloc<T>) {
        self.ptr.free();
    }
}

impl<T: Copy> Alloc<T> {
    pub fn filled(size: usize, initial_value: T) -> Self {
        let mut ptr = null<T>();
        ptr.resize(size);

        let mut alloc = Alloc { ptr, count: size };

        alloc.fill(initial_value);

        alloc
    }

    pub fn fill(&mut self, value: T) {
        for i in 0..self.count {
            .put_at(i, value);
        }
    }
}

@test
fn test() {
    assert(1 == 0, "lol");
}
