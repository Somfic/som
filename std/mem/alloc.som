extern "c";

struct Allocation {
    ptr: *,
    size: i32,
}

fn alloc(size: i32) -> Allocation {
    Allocation {
        ptr: c::malloc(size as u64),
        size: size,
    }
}

fn dealloc(allocation: &Allocation) {
    free(allocation.ptr);
}

fn malloc(size: i32) -> * = c::malloc(size as u64);

fn free(p: *) = c::free(p);
