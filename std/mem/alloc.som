// A memory allocation for T
pub struct Alloc<T> {
    ptr: *T,
    pub size: usize
}

impl<T> Alloc<T> {
    pub fn empty() -> Self {
        Alloc { ptr: null<T>(), size: 0 }
    }

    pub fn with_capacity(size: usize) -> Self {
        let mut ptr = null<T>();
        ptr.resize(size);
        Alloc { ptr, size }
    }

    pub fn resize(&mut self, size: usize) {
        self.ptr.resize(size);
        self.size = size;
    }

    pub fn write(&mut self, index: usize, value: T) {
        self.ptr.write(index, value)
    }

    pub fn read(&mut self, index: usize) -> T {
        self.ptr.read(index)
    }

    pub fn at(&self, index: usize) -> &T {
        self.ptr.at(index)
    }

    pub fn at(&mut self, index: usize) -> &mut T {
        self.ptr.at_mut(index)
    }

    pub fn view(&self, len: usize) -> &[T] {
        self.ptr.view(len)
    }

    pub fn view(&mut self, len: usize) -> &mut [T] {
        self.ptr.view_mut(len)
    }
}

impl<T> Drop for Alloc<T> {
    fn drop(self: &mut Alloc<T>) {
        self.ptr.free();
    }
}

impl<T: Copy> Alloc<T> {
    pub fn with_capacity(size: usize, initial_value: T) -> Self {
        let mut ptr = null<T>();
        ptr.resize(size);

        let mut alloc = Alloc { ptr, size };

        alloc.write_all(initial_value);

        alloc
    }

    pub fn write_all(&mut self, value: T) {
        for i in 0..self.size {
            .write(i, value);
        }
    }
}
