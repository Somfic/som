struct Alloc<T> {
    ptr: *T,
    size: usize
}

impl<T> Alloc<T> {
    fn new() {
        Alloc { ptr: null<T>(), size: 0 }
    }

    fn new(size: usize) {
        let mut ptr = null<T>();
        ptr.resize(size);
        Alloc { ptr, size }
    }

    fn resize(&mut self, size: usize) {
        self.ptr.resize(size);
    }

    fn set(&mut self, at: usize, value: T) {
        self.ptr.write(at, value)
    }

    fn push(&mut self, value: T) {
        self.ptr.
    }

    fn get(&mut self, at: usize) {
        self.ptr.read(at)
    }
}
