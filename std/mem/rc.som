struct RcBox<T> {
    value: T,
    count: usize,
}

pub struct Rc<T> {
    ptr: *RcBox<T>,
}

impl<T> Rc<T> {
    pub fn new(value: T) -> Self {
        let mut ptr = null<RcBox<T>>();

        ptr.resize(1);
        ptr.put(0, RcBox { count: 1, value });

        Rc { ptr }
    }

    pub fn get(&self) -> &T {
        &self.ptr.at(0).value
    }

    pub prop count = .ptr.at(0).count;
}

impl<T> Share for Rc<T> {
    fn share(&self) -> Self {
        let shared = self.ptr.at_mut(0);

        // increase reference count
        shared.count = shared.count + 1;

        Rc { ptr: self.ptr }
    }
}

impl<T> Drop for Rc<T> {
    fn drop(&mut self) {
        let shared = self.ptr.at_mut(0);
        shared.count = shared.count - 1;

        if shared.count <= 0 {
            // last reference got dropped, free
            let last = self.ptr.take(0);
            self.ptr.free();
        }
    }
}

/// What copying a `T?` of a `Share` `T` does: shares what it holds, if it holds anything.
fn share_optional<T: Share>(value: &(T?)) -> T? {
    let held = value else return none;
    Share::share(held)
}
