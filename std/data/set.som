pub struct Set<T> {
    map: Map<T, ()>
}

impl<T: Eq + Hash> Set<T> {
    pub fn empty() -> Self {
        Set { map: Map::empty() }
    }

    pub fn with_capacity(size: usize) -> Self {
        Set { map: Map::with_capacity(size) }
    }

    pub fn insert(&mut self, value: T) {
        .map.insert(value, ());
    }

    pub fn contains(&self, value: &T) -> bool {
        .map.get(value) != none
    }
}

impl<T> Sized for Set<T> {
    pub prop len = .map.len;
}
