use som::mem;

pub struct ArrayIntoIter<T, N: usize> {
    items: Manual<[T; N]>,
    next: usize,
}

impl<T, N: usize> IterOwned for [T; N] {
    type Iter = ArrayIntoIter<T, N>;

    fn into_iter(self) -> ArrayIntoIter<T, N> {
        ArrayIntoIter { items: Manual { value: self }, next: 0 }
    }
}

impl<T, N: usize> Iterator for ArrayIntoIter<T, N> {
    type Item = T;

    fn next(&mut self) -> T? {
        if .next == N {
            return none;
        }
        let items = &.items.value as *T;
        let value = items.take(.next);
        .next = .next + 1;
        value
    }
}

impl<T, N: usize> Drop for ArrayIntoIter<T, N> {
    /// Drops the elements it hasn't given away.
    fn drop(&mut self) {
        let items = &.items.value as *T;
        for i in .next..N {
            drop(items.take(i));
        }
    }
}

impl<T> Sized for [T] {
    /// How many values it has: its built-in length.
    prop len: usize = self.len;
}

impl<T> Index for [T] {
    type Item = T;

    fn at(&self, i: usize) -> &T = (self as *T).at(i);
}

impl<T> IndexMut for [T] {
    fn at_mut(&mut self, i: usize) -> &mut T = (self as *T).at_mut(i);
}
