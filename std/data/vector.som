type Vector2i = Vector<2, i32>;
type Vector3i = Vector<3, i32>;

type Vector2f = Vector<2, f32>;
type Vector3f = Vector<3, f32>;

struct Vector<N: usize, T> {
    components: [T; N]
}

impl<N: usize, T> Vector<N, T> {
    fn new(components: [T; N]) {
        Vector { components }
    }

    fn empty(empty: T) {
        Vector { components: [empty; N] }
    }
}

impl<T> Vector<2, T> {
    prop x = .components[0];
    prop y = .components[1];
}

impl Vector<2, i32> {
    fn zero() {
        Self { components: [ 0, 0 ]}
    }
}

impl Vector<2, i64> {
    fn zero() {
        Self { components: [ 0, 0 ]}
    }
}

impl Vector<2, f32> {
    prop magintude = f32::sqrt(.x * .x + .y * .y);
    prop normalized {
        Self { components: [ .x / .magintude, .y / .magintude ] }
    }

    fn zero() {
        Self { components: [ 0.0, 0.0 ]}
    }
}

impl Vector<2, f64> {
    prop magintude = f64::sqrt(.x * .x + .y * .y);
    prop normalized {
        Self { components: [ .x / .magintude, .y / .magintude ] }
    }

    fn zero() {
        Self { components: [ 0.0, 0.0 ]}
    }
}

impl Vector<3, i32> {
    fn zero() {
        Self { components: [ 0, 0, 0 ]}
    }
}

impl Vector<3, i64> {
    fn zero() {
        Self { components: [ 0, 0, 0 ]}
    }
}

impl Vector<3, f32> {
    prop magintude = f32::sqrt(.x * .x + .y * .y + .z * .z);
    prop normalized {
        Self { components: [ .x / .magintude, .y / .magintude, .z / .magintude ] }
    }

    fn zero() {
        Self { components: [ 0.0, 0.0, 0.0 ]}
    }
}

impl Vector<3, f64> {
    prop magintude = f64::sqrt(.x * .x + .y * .y + .z * .z);
    prop normalized {
        Self { components: [ .x / .magintude, .y / .magintude, .z / .magintude ] }
    }

    fn zero() {
        Self { components: [ 0.0, 0.0, 0.0 ]}
    }
}

impl<T> Vector<3, T> {
    prop x = .components[0];
    prop y = .components[1];
    prop z = .components[2];

    prop xy: Vector = [.x, .y];
    prop yz: Vector = [.y, .z];
    prop xz: Vector = [.x, .z];
}

impl<T> Vector<4, T> {
    prop x = .components[0];
    prop y = .components[1];
    prop z = .components[2];
    prop w = .components[3];

    prop xy: Vector = [.x, .y];
    prop yz: Vector = [.y, .z];
    prop xz: Vector = [.x, .z];

    prop xyz: Vector = [.x, .y, .z];
}

impl<N: usize, T> From<[T; N]> for Vector<N, T> {
    fn from(components: [T; N]) -> Self {
        Vector { components: components }
    }
}

impl<N: usize, T> From<Vector<N, T>> for [T; N]  {
    fn from(vector: Vector<N, T>) -> [T; N] {
        vector.components
    }
}
