pub type Vector2i = Vector<2, i32>;
pub type Vector3i = Vector<3, i32>;

pub type Vector2f = Vector<2, f32>;
pub type Vector3f = Vector<3, f32>;

pub type Vector2d = Vector<2, f64>;
pub type Vector3d = Vector<3, f64>;

pub struct Vector<N: usize, T> {
    components: [T; N]
}

impl<N: usize, T> Vector<N, T> {
    pub fn new(components: [T; N]) {
        Vector { components }
    }

}

impl<N: usize, T: Copy> Vector<N, T> {
    /// Every component a copy of `value`.
    pub fn empty(empty: T) {
        Vector { components: [empty; N] }
    }
}

impl<T: Copy> Vector<2, T> {
    pub prop x = .components[0];
    pub prop y = .components[1];
}

impl Vector<2, i32> {
    pub fn zero() {
        Self { components: [ 0, 0 ]}
    }
}

impl Vector<2, i64> {
    pub fn zero() {
        Self { components: [ 0, 0 ]}
    }
}

impl Vector<2, f32> {
    pub prop magnitude = f32::sqrt(.x * .x + .y * .y);
    pub prop normalized {
        Self { components: [ .x / .magnitude, .y / .magnitude ] }
    }

    pub fn zero() {
        Self { components: [ 0.0, 0.0 ]}
    }
}

impl Vector<2, f64> {
    pub prop magnitude = f64::sqrt(.x * .x + .y * .y);
    pub prop normalized {
        Self { components: [ .x / .magnitude, .y / .magnitude ] }
    }

    pub fn zero() {
        Self { components: [ 0.0, 0.0 ]}
    }
}

impl Vector<3, i32> {
    pub fn zero() {
        Self { components: [ 0, 0, 0 ]}
    }
}

impl Vector<3, i64> {
    pub fn zero() {
        Self { components: [ 0, 0, 0 ]}
    }
}

impl Vector<3, f32> {
    pub prop magnitude = f32::sqrt(.x * .x + .y * .y + .z * .z);
    pub prop normalized {
        Self { components: [ .x / .magnitude, .y / .magnitude, .z / .magnitude ] }
    }

    pub fn zero() {
        Self { components: [ 0.0, 0.0, 0.0 ]}
    }
}

impl Vector<3, f64> {
    pub prop magnitude = f64::sqrt(.x * .x + .y * .y + .z * .z);
    pub prop normalized {
        Self { components: [ .x / .magnitude, .y / .magnitude, .z / .magnitude ] }
    }

    pub fn zero() {
        Self { components: [ 0.0, 0.0, 0.0 ]}
    }
}

impl<T: Copy> Vector<3, T> {
    pub prop x = .components[0];
    pub prop y = .components[1];
    pub prop z = .components[2];

    pub prop xy: Vector = [.x, .y];
    pub prop yz: Vector = [.y, .z];
    pub prop xz: Vector = [.x, .z];
}

impl<T: Copy> Vector<4, T> {
    pub prop x = .components[0];
    pub prop y = .components[1];
    pub prop z = .components[2];
    pub prop w = .components[3];

    pub prop xy: Vector = [.x, .y];
    pub prop yz: Vector = [.y, .z];
    pub prop xz: Vector = [.x, .z];

    pub prop xyz: Vector = [.x, .y, .z];
}

impl<N: usize, T> From<[T; N]> for Vector<N, T> {
    fn from(components: [T; N]) -> Self {
        Vector { components: components }
    }
}

impl<N: usize, T> From<Vector<N, T>> for [T; N]  {
    fn from(vector: Vector<N, T>) -> [T; N] {
        vector.components
    }
}
