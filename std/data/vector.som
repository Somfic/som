struct Vector<N: usize, T> {
    values: [T; N]
}

impl<N: usize, T> Vector<N, T> {
    fn new(values: [T; N]) {
        Vector { values }
    }

    fn empty(empty: T) {
        Vector { values: [empty; N] }
    }
}

impl<T> Vector<2, T> {
    prop x = .values[0];
    prop y = .values[1];
}

impl Vector<2, f32> {
    prop magintude = f32::sqrt(.x * .x + .y * .y);
    prop normalized {
        Self { values: [ .x / .magintude, .y / .magintude ] }
    }

    fn zero() {
        Self { values: [ 0.0, 0.0 ]}
    }
}

impl Vector<2, f64> {
    prop magintude = f64::sqrt(.x * .x + .y * .y);
    prop normalized {
        Self { values: [ .x / .magintude, .y / .magintude ] }
    }

    fn zero() {
        Self { values: [ 0.0, 0.0 ]}
    }
}

impl Vector<3, f32> {
    prop magintude = f32::sqrt(.x * .x + .y * .y + .z * .z);
    prop normalized {
        Self { values: [ .x / .magintude, .y / .magintude, .z / .magintude ] }
    }

    fn zero() {
        Self { values: [ 0.0, 0.0, 0.0 ]}
    }
}

impl Vector<3, f64> {
    prop magintude = f64::sqrt(.x * .x + .y * .y + .z * .z);
    prop normalized {
        Self { values: [ .x / .magintude, .y / .magintude, .z / .magintude ] }
    }

    fn zero() {
        Self { values: [ 0.0, 0.0, 0.0 ]}
    }
}

impl<T> Vector<3, T> {
    prop x = .values[0];
    prop y = .values[1];
    prop z = .values[2];

    prop xy: Vector = [.x, .y];
    prop yz: Vector = [.y, .z];
    prop xz: Vector = [.x, .z];
}

impl<T> Vector<4, T> {
    prop x = .values[0];
    prop y = .values[1];
    prop z = .values[2];
    prop w = .values[3];

    prop xy: Vector = [.x, .y];
    prop yz: Vector = [.y, .z];
    prop xz: Vector = [.x, .z];

    prop xyz: Vector = [.x, .y, .z];
}

impl<N: usize, T> From<[T; N]> for Vector<N, T> {
    fn from(values: [T; N]) -> Self {
        Vector { values: values }
    }
}

impl<N: usize, T> From<Vector<N, T>> for [T; N]  {
    fn from(vector: Vector<N, T>) -> [T; N] {
        vector.values
    }
}
