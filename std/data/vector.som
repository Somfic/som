struct Vector<N: usize, T> {
    values: [T; N]
}

impl<N: usize, T> Vector<N, T> {
    fn new(values: [T; N]) {
        Vector { values }
    }

    fn empty(empty: T) {
        Vector { values: [empty; N] }
    }
}

impl<T> Vector<2, T> {
    prop x = self.values[0];
    prop y = self.values[1];
}

impl Vector<2, f32> {
    prop magintude = f32::sqrt(self.x * self.x + self.y * self.y);
    prop normalized {
        let magnitude = self.magintude;

        Self { values: [ self.x / magnitude, self.y / magnitude ] }
    }
}

impl Vector<3, f32> {
    prop magintude = f32::sqrt(self.x * self.x + self.y * self.y + self.z * self.z);
    prop normalized {
        let magnitude = self.magintude;

        Self { values: [ self.x / magnitude, self.y / magnitude, self.z / magnitude ] }
    }
}

impl<T> Vector<3, T> {
    prop x = self.values[0];
    prop y = self.values[1];
    prop z = self.values[2];

    prop xy: Vector = [self.x, self.y];
    prop yz: Vector = [self.y, self.z];
    prop xz: Vector = [self.x, self.z];
}

impl<T> Vector<4, T> {
    prop x = self.values[0];
    prop y = self.values[1];
    prop z = self.values[2];
    prop w = self.values[3];

    prop xy: Vector = [self.x, self.y];
    prop yz: Vector = [self.y, self.z];
    prop xz: Vector = [self.x, self.z];

    prop xyz: Vector = [self.x, self.y, self.z];
}

impl<N: usize, T> From<[T; N]> for Vector<N, T> {
    fn from(values: [T; N]) -> Self {
        Vector { values: values }
    }
}

impl<N: usize, T> From<Vector<N, T>> for [T; N]  {
    fn from(vector: Vector<N, T>) -> [T; N] {
        vector.values
    }
}
