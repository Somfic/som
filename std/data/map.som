pub struct Pair<K, V> {
    key: K,
    value: V
}

pub struct Map<K, V> {
    keys: Alloc<usize?>,
    entries: List<Pair<K, V>>,
}

impl<K: Eq + Hash, V> Map<K, V> {
    pub fn empty() -> Self {
        Self::with_capacity(0)
    }

    pub fn with_capacity(size: usize) -> Self {
        // min/starting capacity is 16
        let size = usize::biggest(16, size);

        let mut keys = Alloc::filled(size, none);

        let entries = List::with_capacity(size);

        Self { keys, entries }
    }

    pub fn get_pair(&self, key: &K) -> &Pair<K, V>? {
        let slot = .find_slot(key);
        let entry_index = *.keys.at(slot);

        if entry_index {
            .entries.get(entry_index)
        } else {
            none
        }
    }

    pub fn get_pair_mut(&mut self, key: &K) -> &mut Pair<K, V>? {
        let slot = .find_slot(key);
        let entry_index = *.keys.at(slot);

        if entry_index {
            .entries.get_mut(entry_index)
        } else {
            none
        }
    }

    pub fn get(&self, key: &K) -> &V? {
        let pair = .get_pair(key);
        if pair {
            &pair.value
        } else {
            none
        }
    }

    pub fn get_mut(&mut self, key: &K) -> &mut V? {
        let pair = .get_pair_mut(key);
        if pair {
            &mut pair.value
        } else {
            none
        }
    }

    fn grow(&mut self, size: usize) {
        // grow keys
        .keys = Alloc::filled(size, none);

        // rehash existing entries
        for entry_index in 0..self.entries.len {
            let entry = .entries.get(entry_index) else @unreachable;
            let slot = .find_slot(&entry.key);
            .keys.put_at(slot, entry_index);
        }
    }

    pub fn insert(&mut self, key: K, value: V) {
        // grow if needed
        let rehash_treshold = (.keys.capacity as f32 * 0.75) as usize;
        if .entries.len > rehash_treshold {
            .grow(.keys.capacity * 2);
        }

        // find the existing entry
        let slot = .find_slot(&key);
        let entry_index = *.keys.at(slot);

        if entry_index {
            // overwrite the existing entry
            let entry = .entries.get_mut(entry_index) else @unreachable;
            entry.value = value;
        } else {
            // make a new entry
            .entries.push(Pair { key, value });
            .keys.put_at(slot, .entries.len - 1);
        }
    }

    fn find_slot(&self, key: &K) -> usize {
        let mut hasher = Hasher::new();
        Hash::hash(key, &mut hasher);

        // with_capacity makes at least 16 slots
        if .keys.capacity == 0 @unreachable;
        let mut slot = hasher.finish as usize % .keys.capacity;

        loop {
            let entry_index = *.keys.at(slot) else return slot;
            let entry = .entries.get(entry_index) else @unreachable;
            if entry.key != *key {
                // collision!
                slot = (slot + 1) % .keys.capacity;
                continue;
            }

            break;
        }

        slot
    }
}

impl<K, V> Sized for Map<K, V> {
    pub prop len = .entries.len;
}
