use som::mem;

pub struct List<T> {
    mem: Alloc<T>,
    len: usize,
}

impl<T> List<T> {
    pub fn empty() -> Self {
        List { mem: Alloc::empty(), len: 0 }
    }

    pub fn with_capacity(capacity: usize) -> Self {
        List { mem: Alloc::with_capacity(capacity), len: 0 }
    }

    /// How many values it holds.
    pub prop len = .len;
    pub prop capacity = .mem.size;
    pub prop is_empty = .len == 0;
    pub prop is_full = .len == .capacity;

    pub fn push(&mut self, value: T) {
        if .is_full {
            let capacity = 4 if .capacity == 0 else .capacity * 2;
            .mem.resize(capacity);
        }
        .mem.write(.len, value);
        .len = .len + 1;
    }

    pub fn pop(&mut self) -> T? {
        if .len == 0 {
            return none;
        }
        .len = .len - 1;
        .mem.read(.len)
    }

    pub fn get(&self, index: usize) -> &T? {
        if index >= .len {
            return none;
        }
        .mem.at(index)
    }

    pub fn get_mut(&mut self, index: usize) -> &mut T? {
        if index >= .len {
            return none;
        }
        .mem.at(index)
    }

    pub prop slice = .mem.view(.len);

    pub fn as_slice(&self) -> &[T] {
        .mem.view(.len)
    }

    pub fn as_slice(&mut self) -> &mut [T] {
        .mem.view(.len)
    }

    pub fn clear(&mut self) {
        for i in 0..self.len {
            drop(.mem.read(i));
        }
        .len = 0;
    }
}

impl<T: Copy> List<T> {
    pub fn of(values: &[T]) -> Self {
        let mut list: List<T> = List::with_capacity(values.len);
        for value in values {
            list.push(value);
        }
        list
    }
}

impl<T> Drop for List<T> {
    fn drop(&mut self) {
        .clear();
    }
}

impl<T, N: usize> From<[T; N]> for List<T> {
    fn from(items: [T; N]) -> List<T> {
        let mut list: List<T> = List::with_capacity(items.len);
        for item in items { list.push(item); }
        list
    }
}

impl<T: Copy> From<&[T]> for List<T> {
     fn from(items: &[T]) -> List<T> {
        let mut list: List<T> = List::with_capacity(items.len);
        for item in items { list.push(item); }
        list
    }
}

impl<T> Iterable for List<T> {
    type Iter = ListIter<T>;

    fn iter(self: &List<T>) -> ListIter<T> {
        ListIter { list: self, index: 0 }
    }
}

pub struct ListIter<T> {
    list: &List<T>,
    index: usize,
}

impl<T> Iterator for ListIter<T> {
    type Item = &T;

    fn next(self: &mut ListIter<T>) -> &T? {
        let item = .list.get(.index);
        .index = .index + 1;
        item
    }
}

impl<T> IterableMut for List<T> {
    type IterMut = ListIterMut<T>;

    fn iter_mut(&mut self) -> ListIterMut<T> {
        ListIterMut { list: self, index: 0 }
    }
}

pub struct ListIterMut<T> {
    list: &mut List<T>,
    index: usize,
}

impl<T> Iterator for ListIterMut<T> {
    type Item = &mut T;

    fn next(&mut self) -> &mut T? {
        let item = .list.get_mut(.index);
        .index = .index + 1;
        item
    }
}

impl<T> IntoIterator for List<T> {
    type IntoIter = ListIntoIter<T>;

    fn into_iter(self) -> ListIntoIter<T> {
        ListIntoIter { list: self, next: 0 }
    }
}

pub struct ListIntoIter<T> {
    list: List<T>,
    next: usize,
}

impl<T> Iterator for ListIntoIter<T> {
    type Item = T;

    fn next(&mut self) -> T? {
        if .next == .list.len {
            return none;
        }
        let value = .list.mem.read(.next);
        .next = .next + 1;
        value
    }
}

impl<T> Drop for ListIntoIter<T> {
    /// Drops the values it hasn't given away. The list then holds none, so dropping it only
    /// gives the room back.
    fn drop(&mut self) {
        for i in .next..self.list.len {
            drop(.list.mem.read(i));
        }
        .list.len = 0;
    }
}
