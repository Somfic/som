use som;
use som::mem;

/// `T`s one after another, as many as are pushed: room for more is made as it's needed.
/// Dropping it drops its values and gives their room back.
struct List<T> {
    items: *T,
    len: usize,
    capacity: usize,
}

impl<T> List<T> {
    /// An empty list. It takes no memory until something is pushed.
    fn empty() -> List<T> {
        List { items: null(), len: 0, capacity: 0 }
    }

    fn with_capacity(capacity: usize) -> List<T> {
        let mut items: *T = null();
        items.resize(capacity);
        List { items: items, len: 0, capacity: capacity }
    }

    prop is_empty: bool = .len == 0;
    prop is_full = .len == .capacity;

    /// Adds `value` at the end.
    fn push(self: &mut List<T>, value: T) {
        if .is_full {
            let capacity = 4 if .capacity == 0 else .capacity * 2;
            .items.resize(capacity);
            .capacity = capacity;
        }
        .items.write(.len, value);
        .len = .len + 1;
    }

    /// Takes the last value off, or `none` if it's empty.
    fn pop(self: &mut List<T>) -> T? {
        if .len == 0 {
            return none;
        }
        .len = .len - 1;
        .items.read(.len)
    }

    /// The value at `index`, or `none` past the end.
    fn get(self: &List<T>, index: usize) -> &T? {
        if index >= .len {
            return none;
        }
        .items.at(index)
    }

    /// The value at `index`, to change, or `none` past the end.
    fn get(self: &mut List<T>, index: usize) -> &mut T? {
        if index >= .len {
            return none;
        }
        .items.at_mut(index)
    }

    /// Its values as a slice: `for x in list.as_slice()`, `list.as_slice().get(0)`.
    fn as_slice(self: &List<T>) -> [T] {
        .items.view(.len)
    }

    /// Its values as a slice that can change them.
    fn as_slice_mut(self: &mut List<T>) -> [mut T] {
        .items.view_mut(.len)
    }

    /// Drops every value, keeping the room for new ones.
    fn clear(self: &mut List<T>) {
        for i in 0..self.len {
            drop(.items.read(i));
        }
        .len = 0;
    }
}

impl<T> Drop for List<T> {
    /// Drops each value, read out of its room, then gives the room back.
    fn drop(self: &mut List<T>) {
        for i in 0..self.len {
            drop(.items.read(i));
        }
        .items.free();
    }
}

// `let list: List<i32> = [1, 2, 3]`: the values moved into a new list.
impl<T, N: usize> From<[T; N]> for List<T> {
    fn from(items: [T; N]) -> List<T> {
        let mut list: List<T> = List::empty();
        list.items.resize(N);
        list.capacity = N;
        let source = &items as *T;
        for i in 0..N {
            list.items.write(i, source.read(i));
        }
        list.len = N;
        // Its values are the list's now: the array mustn't drop them too.
        forget(items);
        list
    }
}

// `let list: List<i32> = numbers.as_slice()`: the values copied into a new list. Only for
// values that are copied, as the slice's still have them.
impl<T: Copy> From<[T]> for List<T> {
    fn from(items: [T]) -> List<T> {
        let mut list: List<T> = List::empty();
        list.items.resize(items.len());
        list.capacity = items.len();
        let source = items as *T;
        for i in 0..items.len() {
            list.items.write(i, source.read(i));
        }
        list.len = items.len();
        list
    }
}

/// `for x in list`: each value, by reference.
impl<T> Iterable for List<T> {
    type Iter = ListIter<T>;

    fn iter(self: &List<T>) -> ListIter<T> {
        ListIter { list: self, index: 0 }
    }
}

/// Goes through a list's values, by reference.
struct ListIter<T> {
    list: &List<T>,
    index: usize,
}

impl<T> Iterator for ListIter<T> {
    type Item = &T;

    fn next(self: &mut ListIter<T>) -> &T? {
        let item = .list.get(.index);
        .index = .index + 1;
        item
    }
}
