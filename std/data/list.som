use som;
use som::mem;

/// `T`s one after another, as many as are pushed: room for more is made as it's needed.
/// Its memory isn't given back by itself yet: call `free` when it's no longer needed.
struct List<T> {
    items: *T,
    len: usize,
    capacity: usize,
}

impl<T> List<T> {
    /// An empty list. It takes no memory until something is pushed.
    fn new() -> List<T> {
        List { items: null(), len: 0, capacity: 0 }
    }

    /// How many values it holds.
    fn len(self: &List<T>) -> usize {
        self.len
    }

    fn is_empty(self: &List<T>) -> bool {
        self.len == 0
    }

    /// Adds `value` at the end.
    fn push(self: &mut List<T>, value: T) {
        if self.len == self.capacity {
            let capacity = 4 if self.capacity == 0 else self.capacity * 2;
            self.items = self.items.resize(capacity);
            self.capacity = capacity;
        }
        self.items.write(self.len, value);
        self.len = self.len + 1;
    }

    /// Takes the last value off, or `none` if it's empty.
    fn pop(self: &mut List<T>) -> T? {
        if self.len == 0 {
            return none;
        }
        self.len = self.len - 1;
        self.items.read(self.len)
    }

    /// The value at `index`, or `none` past the end.
    fn get(self: &List<T>, index: usize) -> &T? {
        if index >= self.len {
            return none;
        }
        self.items.at(index)
    }

    /// The value at `index`, to change, or `none` past the end.
    fn get(self: &mut List<T>, index: usize) -> &mut T? {
        if index >= self.len {
            return none;
        }
        self.items.at_mut(index)
    }

    /// Its values as a slice: `for x in list.as_slice()`, `list.as_slice().get(0)`.
    fn as_slice(self: &List<T>) -> [T] {
        self.items.view(self.len)
    }

    /// Its values as a slice that can change them.
    fn as_slice_mut(self: &mut List<T>) -> [mut T] {
        self.items.view_mut(self.len)
    }

    /// Forgets every value, keeping the room for new ones.
    fn clear(self: &mut List<T>) {
        self.len = 0;
    }

    /// Gives its memory back. The values in it aren't freed themselves.
    fn free(self: List<T>) {
        self.items.free()
    }
}

// `let list: List<i32> = [1, 2, 3]`: the values moved into a new list.
impl<T> FromArray for List<T> {
    type Element = T;

    fn from_array<N: usize>(items: [T; N]) -> List<T> {
        let mut list: List<T> = List::new();
        list.items = list.items.resize(N);
        list.capacity = N;
        let source = &items as *T;
        for i in 0..N {
            list.items.write(i, source.read(i));
        }
        list.len = N;
        list
    }
}

// /// `for x in list`: each value, by reference.
// impl<T> Iterable for List<T> {
//     type Iter = ListIter<T>;

//     fn iter(self: &List<T>) -> ListIter<T> {
//         ListIter { list: self, index: 0 }
//     }
// }

/// Goes through a list's values, by reference.
struct ListIter<T> {
    list: &List<T>,
    index: usize,
}

impl<T> Iterator for ListIter<T> {
    type Item = &T;

    fn next(self: &mut ListIter<T>) -> &T? {
        let item = self.list.get(self.index);
        self.index = self.index + 1;
        item
    }
}
