struct String {
    value: List<u8>
}

impl String {
    fn new(string: str) -> String {
        String { value: string.bytes() }
    }

    fn len(self: &String) -> i32 {
        .value.len() as i32
    }
}

impl From<str> for String {
    fn from(value: str) -> String {
        String::new(value)
    }
}

impl Add for String {
    fn add(self: &String, other: &String) -> String {
        let mut bytes: List<u8> = List::with_capacity((.len() + other.len()) as usize);

        for byte in .value {
            bytes.push(*byte);
        }

         for byte in other.value {
            bytes.push(*byte);
        }

        String { value: bytes }
    }
}
