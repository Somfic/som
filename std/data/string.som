pub struct String {
    bytes: List<u8>
}

impl String {
    pub fn new(string: str) -> Self {
        String { bytes: string.bytes() }
    }

    pub prop len = .bytes.len;
}

impl From<str> for String {
    fn from(value: str) -> Self {
        String::new(value)
    }
}

impl Add for String {
    fn add(&self, other: &Self) -> Self {
        let mut bytes: List<u8> = List::with_capacity(.len + other.len);

        for byte in &.bytes {
            bytes.push(byte);
        }

         for byte in &other.bytes {
            bytes.push(byte);
        }

        Self { bytes }
    }
}

impl Hash for String {
    fn hash(&self, hasher: &mut Hasher) {
        hasher.write(.bytes.as_slice());
        hasher.write(.len as u64);
    }
}
