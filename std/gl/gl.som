//! GLSL's built-in functions: what a shader can call that the CPU has no such thing as. They
//! only exist on the GPU, so they're called inside `@if GPU { … }`, as `som::c`'s are inside
//! `@if !GPU { … }`. The standard library's math does that already: `f32::sin` is GLSL's
//! `sin` in a shader and C's `sinf` everywhere else.

extern "glsl" {
    pub fn sin(x: f32) -> f32;
    pub fn cos(x: f32) -> f32;
    pub fn tan(x: f32) -> f32;
    pub fn asin(x: f32) -> f32;
    pub fn acos(x: f32) -> f32;
    pub fn atan(x: f32) -> f32;
    /// The angle of `(x, y)`: GLSL's `atan` of two, as C names it.
    pub fn atan2(y: f32, x: f32) -> f32;
    pub fn sinh(x: f32) -> f32;
    pub fn cosh(x: f32) -> f32;
    pub fn tanh(x: f32) -> f32;
    pub fn pow(x: f32, y: f32) -> f32;
    pub fn exp(x: f32) -> f32;
    pub fn exp2(x: f32) -> f32;
    /// The natural logarithm.
    pub fn log(x: f32) -> f32;
    pub fn log2(x: f32) -> f32;
    pub fn sqrt(x: f32) -> f32;
    /// `1 / sqrt(x)`, faster.
    pub fn inversesqrt(x: f32) -> f32;
    pub fn abs(x: f32) -> f32;
    /// -1, 0 or 1.
    pub fn sign(x: f32) -> f32;
    pub fn floor(x: f32) -> f32;
    pub fn ceil(x: f32) -> f32;
    pub fn trunc(x: f32) -> f32;
    pub fn round(x: f32) -> f32;
    /// `x - floor(x)`.
    pub fn fract(x: f32) -> f32;
    pub fn min(x: f32, y: f32) -> f32;
    pub fn max(x: f32, y: f32) -> f32;
    pub fn clamp(x: f32, low: f32, high: f32) -> f32;
    /// From `x` at 0 to `y` at 1.
    pub fn mix(x: f32, y: f32, t: f32) -> f32;
    /// 0 below `edge`, 1 from it on.
    pub fn step(edge: f32, x: f32) -> f32;
    pub fn smoothstep(low: f32, high: f32, x: f32) -> f32;
    /// How fast `x` changes from one pixel to the next, across the screen. Fragment shaders only.
    pub fn dFdx(x: f32) -> f32;
    /// How fast `x` changes from one pixel to the next, down the screen. Fragment shaders only.
    pub fn dFdy(x: f32) -> f32;
    /// `abs(dFdx(x)) + abs(dFdy(x))`: for edges that stay sharp at any size.
    pub fn fwidth(x: f32) -> f32;
}
