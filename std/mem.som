extern {
    fn malloc(size: i32) -> *;
    fn free(p: *);
    fn realloc(p: *, size: i32) -> *;
    fn memcpy(dest: *, src: *, n: i32) -> *;
    fn memset(s: *, c: i32, n: i32) -> *;
}

/// A pointer to nothing: C's `NULL`.
fn null() -> * {
    leave(out p);
    p
}

/// Leaves `p` as it is. An `out` variable starts zeroed, so this one stays null.
fn leave(p: &mut *) {}
