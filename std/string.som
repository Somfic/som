        let held = value else return "none";
        string::from(held)
    }
}
impl From<isize?> for string {
    fn from(value: isize?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<u8?> for string {
    fn from(value: u8?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<u16?> for string {
    fn from(value: u16?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<u32?> for string {
    fn from(value: u32?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<u64?> for string {
    fn from(value: u64?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<usize?> for string {
    fn from(value: usize?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<f32?> for string {
    fn from(value: f32?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<f64?> for string {
    fn from(value: f64?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<bool?> for string {
    fn from(value: bool?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
impl From<string?> for string {
    fn from(value: string?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}

/// An optional reference as text, as `List`'s `get` gives: what it refers to, or `none`.
impl From<&i8?> for string {
    fn from(value: &i8?) -> string {
        let held = value else return "none";
        string::from(held)
    }
}
