use som::c;
use som::mem;

pub struct string {
    view: *StringView,
}

struct StringView {
    /// How many copies of the `string` share it.
    count: usize,
    /// How many bytes follow it, not counting the zero byte after them.
    len: usize,
}

impl string {
    fn with_len(len: usize) -> Self {
        let mut raw = null<u8>();
        // The block, the bytes, and the zero byte after them.
        raw.resize(16 + len + 1);
        let view = raw as *StringView;
        view.put(0, StringView { count: 1, len });
        let text = Self { view };
        text.data.put(len, 0);
        text
    }

    prop data = .view.at(1) as *u8;

    /// A copy of `bytes`, as text.
    pub fn from_bytes(bytes: &[u8]) -> Self {
        let copy = string::with_len(bytes.len);
        let mut i = 0;
        for byte in bytes {
            copy.data.put(i, byte);
            i = i + 1;
        }
        copy
    }

    /// A copy of the bytes C's `text` has, up to its zero byte.
    pub fn from_c(text: cstr) -> Self {
        let len = c::strlen(text) as usize;
        let copy = string::with_len(len);
        c::memcpy(copy.data as *, text as *, len as u64);
        copy
    }

    /// Its bytes, lent: a view of them, not a copy.
    pub prop bytes: &[u8] = .data.view(.len);

    /// Its bytes, for C, which reads up to the zero byte after them. Valid as long as
    /// this copy of it is.
    pub prop c_str: cstr = .data as cstr;

    /// The byte at `index`, or `none` past its end.
    pub fn get(&self, index: usize) -> u8? {
        if index >= .len {
            return none;
        }
        .data.take(index)
    }

    /// The bytes from `start` up to `end`, copied; `none` if they aren't all there.
    pub fn slice(&self, start: usize, end: usize) -> Self? {
        if start > end || end > .len {
            return none;
        }
        let copy = string::with_len(end - start);
        c::memcpy(copy.data as *, .data.at(start) as *u8 as *, (end - start) as u64);
        copy
    }
}

impl Share for string {
    fn share(&self) -> Self {
        let view = .view.at_mut(0);
        // A literal's count is `usize::MAX`: it's part of the program, never counted.
        if view.count != usize::MAX {
            view.count = view.count + 1;
        }
        Self { view: .view }
    }
}

impl Drop for string {
    fn drop(&mut self) {
        let view = .view.at_mut(0);
        // A literal's: part of the program, never freed.
        if view.count == usize::MAX {
            return;
        }
        view.count = view.count - 1;
        if view.count == 0 {
            (.view as *u8).free();
        }
    }
}

impl Add for string {
    fn add(&self, other: &Self) -> Self {
        let joined = string::with_len(.len + other.len);
        c::memcpy(joined.data as *, .data as *, .len as u64);
        c::memcpy(joined.data.at(.len) as *u8 as *, other.data as *, other.len as u64);
        joined
    }
}
/// The text `times` times over: `"ab" * 3` is `"ababab"`.
impl Multiply<usize> for string {
    fn multiply(&self, times: &usize) -> Self {
        let repeated = string::with_len(.len * *times);
        for i in 0..*times {
            c::memcpy(repeated.data.at(i * .len) as *u8 as *, .data as *, .len as u64);
        }
        repeated
    }
}

impl Eq for string {
    fn eq(&self, other: &Self) -> bool {
        .len == other.len && c::memcmp(.data as *, other.data as *, .len as u64) == 0
    }
}

/// C's text as som's: a copy. It's what lets `failure.at.function == "pick"` compare them.
impl From<cstr> for string {
    fn from(text: cstr) -> Self = string::from_c(text);
}

impl Hash for string {
    fn hash(&self, hasher: &mut Hasher) {
        hasher.write(.bytes);
        hasher.write(.len as u64);
    }
}

impl Sized for string {
    prop len = .view.at(0).len;
}

impl Index for string {
    type Item = u8;

    fn at(&self, i: usize) -> &u8 = .data.at(i);
}

impl Display for i64 {
    prop display_len: usize {
        let mut room: [i8; 1] = [0];
        c::snprintf(&mut room[0], 1, "%lld", *self) as usize
    }

    fn display(&self, to: *u8) {
        c::snprintf((to as *i8).at_mut(0), (.display_len + 1) as u64, "%lld", *self);
    }
}

impl Display for u64 {
    prop display_len: usize {
        let mut room: [i8; 1] = [0];
        c::snprintf(&mut room[0], 1, "%llu", *self) as usize
    }
    fn display(&self, to: *u8) {
        c::snprintf((to as *i8).at_mut(0), (.display_len + 1) as u64, "%llu", *self);
    }
}

impl Display for f64 {
    prop display_len: usize {
        let mut room: [i8; 1] = [0];
        c::snprintf(&mut room[0], 1, "%g", *self) as usize
    }
    fn display(&self, to: *u8) {
        c::snprintf((to as *i8).at_mut(0), (.display_len + 1) as u64, "%g", *self);
    }
}

impl Display for i8 {
    prop display_len: usize = (*self as i64).display_len;
    fn display(&self, to: *u8) { (*self as i64).display(to); }
}
impl Display for i16 {
    prop display_len: usize = (*self as i64).display_len;
    fn display(&self, to: *u8) { (*self as i64).display(to); }
}
impl Display for i32 {
    prop display_len: usize = (*self as i64).display_len;
    fn display(&self, to: *u8) { (*self as i64).display(to); }
}
impl Display for isize {
    prop display_len: usize = (*self as i64).display_len;
    fn display(&self, to: *u8) { (*self as i64).display(to); }
}
impl Display for u8 {
    prop display_len: usize = (*self as u64).display_len;
    fn display(&self, to: *u8) { (*self as u64).display(to); }
}
impl Display for u16 {
    prop display_len: usize = (*self as u64).display_len;
    fn display(&self, to: *u8) { (*self as u64).display(to); }
}
impl Display for u32 {
    prop display_len: usize = (*self as u64).display_len;
    fn display(&self, to: *u8) { (*self as u64).display(to); }
}
impl Display for usize {
    prop display_len: usize = (*self as u64).display_len;
    fn display(&self, to: *u8) { (*self as u64).display(to); }
}
impl Display for f32 {
    prop display_len: usize = (*self as f64).display_len;
    fn display(&self, to: *u8) { (*self as f64).display(to); }
}

impl Display for bool {
    prop display_len: usize = 4 if *self else 5;
    fn display(&self, to: *u8) {
        let text = "true" if *self else "false";
        text.display(to);
    }
}

impl Display for string {
    prop display_len: usize = .len;
    fn display(&self, to: *u8) { c::memcpy(to as *, .data as *, .len as u64); }
}

impl Display for cstr {
    prop display_len: usize = c::strlen(*self) as usize;
    fn display(&self, to: *u8) { c::memcpy(to as *, *self as *, .display_len as u64); }
}

/// What it refers to: `println(&value)` shows `value` without giving it up.
impl<T: Display> Display for &T {
    prop display_len: usize = (*self).display_len;
    fn display(&self, to: *u8) { (*self).display(to); }
}

/// What an optional holds, or `none`.
impl<T: Display> Display for T? {
    prop display_len: usize = match self {
        none => 4,
        held => held.display_len,
    };
    fn display(&self, to: *u8) {
        match self {
            none => "none".display(to),
            held => held.display(to),
        };
    }
}

impl string {
    /// Room for an interpolated string's `len` bytes, which `write_piece` and `write_shown`
    /// fill in, in order.
    fn interpolated(len: usize) -> string = string::with_len(len);

    /// Writes the text `piece` at byte `at` of a string being made. Gives where it ends.
    fn write_piece(&self, at: usize, piece: string) -> usize {
        c::memcpy(.data.at(at) as *u8 as *, piece.data as *, piece.len as u64);
        at + piece.len
    }

    /// Writes `value`, `len` bytes of it, at byte `at` of a string being made. Gives where it
    /// ends.
    fn write_shown<T: Display>(&self, at: usize, value: &T, len: usize) -> usize {
        value.display(.data.at(at) as *u8);
        at + len
    }
}
