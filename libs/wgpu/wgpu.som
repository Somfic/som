use extern "wgpu_native" from "webgpu.h";
use extern "SDL3" from "SDL3/SDL.h";
use som::mem;
use som::io;
use som::gpu;

//! A window to draw to and a GPU to work things out on: SDL3 for the window and its input,
//! wgpu (wgpu-native) for the GPU, both imported from their headers (`brew install
//! wgpu-native sdl3`). Shaders and kernels are som closures, compiled to WGSL while compiling
//! (`gpu::shader`, `gpu::kernel`) and loaded the first time they run.
//!
//! ```
//! let mut gpu = wgpu::Gpu::open("demo", 800, 450);
//! let mut background = wgpu::Shader::empty();
//! while gpu.frame() {
//!     let time = gpu.time();
//!     background.fullscreen(&mut gpu, (frag) => vec4(frag.uv.x, 0.5 + 0.5 * time.sin(), 0.5, 1.0));
//!     gpu.present();
//! }
//! ```

/// `WGPUStringView`'s length for text ending in a 0 byte.
@const STRLEN: u64 = 18446744073709551615;
@const UNDEFINED: u32 = 4294967295;
/// At most this many words of uniforms, and textures and buffers, in one shader.
@const UNIFORM_WORDS: usize = 1024;
@const MAX_BOUND: usize = 8;
@const MAX_LOADED: usize = 64;
/// Marks a bound `id` as a buffer's, not a texture's.
@const BUFFER_ID: u32 = 2147483648;

// The flags `webgpu.h` declares as `static const`, which aren't imported.
@const BUFFER_UNIFORM: u64 = 64;
@const BUFFER_COPY_DST: u64 = 8;
@const BUFFER_COPY_SRC: u64 = 4;
@const BUFFER_STORAGE: u64 = 128;
@const BUFFER_MAP_READ: u64 = 1;
@const MAP_READ: u64 = 1;
@const STAGE_FRAGMENT: u64 = 2;
@const STAGE_COMPUTE: u64 = 4;
@const TEXTURE_COPY_DST: u64 = 2;
@const TEXTURE_BINDING: u64 = 4;
@const TEXTURE_RENDER: u64 = 16;
@const WRITE_ALL: u64 = 15;

// SDL's.
@const SDL_INIT_VIDEO: u32 = 32;
@const SDL_WINDOW_RESIZABLE: u64 = 32;
@const SDL_WINDOW_HIGH_PIXEL_DENSITY: u64 = 8192;
@const SDL_WINDOW_METAL: u64 = 536870912;
@const SDL_EVENT_QUIT: u32 = 256;
@const SDL_EVENT_KEY_DOWN: u32 = 768;
@const SDL_BUTTON_LMASK: u32 = 1;
@const SDL_BUTTON_RMASK: u32 = 4;
@const KEYS: usize = 512;

/// A key on the keyboard, where it is rather than what it says: SDL's scancode.
pub enum Key {
    A = 4, B = 5, C = 6, D = 7, E = 8, F = 9, G = 10, H = 11, I = 12, J = 13, K = 14, L = 15,
    M = 16, N = 17, O = 18, P = 19, Q = 20, R = 21, S = 22, T = 23, U = 24, V = 25, W = 26,
    X = 27, Y = 28, Z = 29,
    One = 30, Two = 31, Three = 32, Four = 33, Five = 34, Six = 35, Seven = 36, Eight = 37,
    Nine = 38, Zero = 39,
    Return = 40, Escape = 41, Backspace = 42, Tab = 43, Space = 44,
    Right = 79, Left = 80, Down = 81, Up = 82,
    LeftControl = 224, LeftShift = 225, LeftAlt = 226, RightControl = 228, RightShift = 229,
}

impl Copy for Key {}
/// wgpu-native's `WGPUSurfaceGetCurrentTextureStatus_Occluded`, from `wgpu.h`.
@const OCCLUDED: i32 = 196609;

/// A window drawn to by the GPU, through WebGPU.
pub struct Gpu {
    window: SDLWindow,
    instance: WGPUInstanceImpl,
    surface: WGPUSurfaceImpl,
    adapter: WGPUAdapterImpl,
    device: WGPUDeviceImpl,
    queue: WGPUQueueImpl,
    /// The surface's pixel format.
    format: i32,
    /// Its size, in pixels.
    pub width: i32,
    pub height: i32,
    /// Pixels to a point: 2 on most high density screens. The window's size, the mouse's
    /// and the `Painter`'s are in points.
    pub scale: f32,
    /// This frame's: what's drawn to, and whether it's been cleared yet.
    frame: WGPUTextureImpl,
    view: WGPUTextureViewImpl,
    cleared: bool,
    /// Whether there's anything to draw to this frame.
    drawing: bool,
    /// The textures loaded, each `gpu::Texture`'s `id` one past its index.
    views: [WGPUTextureViewImpl; MAX_LOADED],
    textures: [WGPUTextureImpl; MAX_LOADED],
    loaded: usize,
    /// The storage buffers made, each `gpu::Buffer`'s `id` one past its index, and their
    /// sizes in bytes.
    buffers: [WGPUBufferImpl; MAX_LOADED],
    buffer_sizes: [u64; MAX_LOADED],
    buffer_count: usize,
    start: u64,
    /// When this frame started, and how long after the one before, in seconds.
    now: u64,
    frame_time: f32,
    /// The keys pressed since the frame before, by scancode.
    pressed: [bool; KEYS],
    /// How far the mouse moved since the frame before, in points.
    moved: Vec2,
}

/// What a callback fills in, and whether it has: an adapter or a device.
struct Waiting {
    done: bool,
    ok: bool,
    value: *,
}

fn got_adapter(status: i32, adapter: WGPUAdapterImpl, message: WGPUStringView, into: *, unused: *) {
    let waiting = (into as *Waiting).at_mut(0);
    waiting.done = true;
    waiting.ok = status == WGPURequestAdapterStatus::Success as i32;
    (&mut waiting.value as *WGPUAdapterImpl).put(0, adapter);
}

fn got_device(status: i32, device: WGPUDeviceImpl, message: WGPUStringView, into: *, unused: *) {
    let waiting = (into as *Waiting).at_mut(0);
    waiting.done = true;
    waiting.ok = status == WGPURequestDeviceStatus::Success as i32;
    (&mut waiting.value as *WGPUDeviceImpl).put(0, device);
}

/// A mistake in how the GPU is used, said when wgpu finds it.
fn on_error(device: *, kind: i32, message: WGPUStringView, a: *, b: *) {
    say(message);
}

fn say(message: WGPUStringView) {
    write(2, message.data, message.length);
    write(2, "\n", 1);
}

extern {
    fn write(fd: i32, data: cstr, count: u64) -> i64;
}

/// The mouse buttons held down, a bit each.
fn buttons() -> u32 {
    let mut x: f32 = 0.0;
    let mut y: f32 = 0.0;
    sdl_get_mouse_state(&mut x, &mut y)
}

/// `text`, which ends in a 0 byte, as WebGPU takes text.
fn view(text: cstr) -> WGPUStringView = WGPUStringView { data: text, length: STRLEN };

fn waited(instance: WGPUInstanceImpl, waiting: &Waiting) {
    let at = waiting as * as *Waiting;
    while !at.at(0).done {
        wgpu_instance_process_events(instance);
    }
}

impl Gpu {
    /// Opens a window `width` by `height` (in points: more pixels on a high density
    /// screen) titled `title`, and the GPU to draw to it.
    pub fn open(title: cstr, width: i32, height: i32) -> Gpu {
        sdl_init(SDL_INIT_VIDEO);
        let flags = SDL_WINDOW_METAL | SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY;
        let window = sdl_create_window(title, width, height, flags);
        sdl_raise_window(window);
        let layer = sdl_metal_get_layer(sdl_metal_create_view(window));

        let instance_descriptor: WGPUInstanceDescriptor = zeroed();
        let instance = wgpu_create_instance(&instance_descriptor);
        let mut source: WGPUSurfaceSourceMetalLayer = zeroed();
        source.chain.s_type = WGPUSType::SurfaceSourceMetalLayer as i32;
        source.layer = layer;
        let mut surface_descriptor: WGPUSurfaceDescriptor = zeroed();
        surface_descriptor.next_in_chain = &source as *;
        let surface = wgpu_instance_create_surface(instance, &surface_descriptor);

        let mut options: WGPURequestAdapterOptions = zeroed();
        options.compatible_surface = surface;
        let mut found = Waiting { done: false, ok: false, value: null() };
        let mut asked: WGPURequestAdapterCallbackInfo = zeroed();
        asked.mode = WGPUCallbackMode::AllowProcessEvents as i32;
        asked.callback = got_adapter as *;
        asked.userdata1 = &mut found as *;
        wgpu_instance_request_adapter(instance, &options, asked);
        waited(instance, &found);
        if !found.ok {
            @fail("no GPU adapter");
        }
        let adapter = *(&found.value as *WGPUAdapterImpl).at(0);

        let mut device_descriptor: WGPUDeviceDescriptor = zeroed();
        device_descriptor.uncaptured_error_callback_info.callback = on_error as *;
        let mut made = Waiting { done: false, ok: false, value: null() };
        let mut asked_device: WGPURequestDeviceCallbackInfo = zeroed();
        asked_device.mode = WGPUCallbackMode::AllowProcessEvents as i32;
        asked_device.callback = got_device as *;
        asked_device.userdata1 = &mut made as *;
        wgpu_adapter_request_device(adapter, &device_descriptor, asked_device);
        waited(instance, &made);
        if !made.ok {
            @fail("no GPU device");
        }
        let device = *(&made.value as *WGPUDeviceImpl).at(0);

        // Plain 8-bit colour, as raylib draws: a shader's colours are written as they are.
        let mut capabilities: WGPUSurfaceCapabilities = zeroed();
        wgpu_surface_get_capabilities(surface, adapter, &mut capabilities);
        let formats = capabilities.formats as *i32;
        let mut format = *formats.at(0);
        for i in 0..capabilities.format_count as usize {
            if *formats.at(i) == WGPUTextureFormat::BGRA8Unorm as i32 {
                format = WGPUTextureFormat::BGRA8Unorm as i32;
            }
        }

        let mut gpu = Gpu {
            window,
            instance,
            surface,
            adapter,
            device,
            queue: wgpu_device_get_queue(device),
            format,
            width: 0,
            height: 0,
            scale: 1.0,
            frame: zeroed(),
            view: zeroed(),
            cleared: false,
            drawing: false,
            views: zeroed(),
            textures: zeroed(),
            loaded: 0,
            buffers: zeroed(),
            buffer_sizes: zeroed(),
            buffer_count: 0,
            start: sdl_get_ticks(),
            now: sdl_get_ticks(),
            frame_time: 0.0,
            pressed: [false; KEYS],
            moved: vec2(0.0, 0.0),
        };
        gpu.fit();
        gpu
    }

    /// Sizes the surface to the window, if it isn't.
    fn fit(&mut self) {
        let mut width = 0;
        let mut height = 0;
        sdl_get_window_size_in_pixels(self.window, &mut width, &mut height);
        if width == self.width && height == self.height {
            return;
        }
        self.width = width;
        self.height = height;
        let mut points = 0;
        let mut unused = 0;
        sdl_get_window_size(self.window, &mut points, &mut unused);
        self.scale = if points > 0 { width as f32 / points as f32 } else { 1.0 };
        let mut config: WGPUSurfaceConfiguration = zeroed();
        config.device = self.device;
        config.format = self.format;
        config.usage = TEXTURE_RENDER;
        config.width = width as u32;
        config.height = height as u32;
        config.alpha_mode = WGPUCompositeAlphaMode::Auto as i32;
        config.present_mode = WGPUPresentMode::Fifo as i32;
        wgpu_surface_configure(self.surface, &config);
    }

    /// Starts a frame: `false` once the window is closed (or Escape pressed).
    pub fn frame(&mut self) -> bool {
        let mut event: [u32; 32] = zeroed();
        self.pressed = [false; KEYS];
        while sdl_poll_event(&mut event as *) {
            if event[0] == SDL_EVENT_QUIT {
                return false;
            }
            if event[0] == SDL_EVENT_KEY_DOWN && event[6] == Key::Escape as u32 {
                return false;
            }
            let key = event[6] as usize;
            if event[0] == SDL_EVENT_KEY_DOWN && key < self.pressed.len {
                self.pressed[key] = true;
            }
        }
        let mut dx: f32 = 0.0;
        let mut dy: f32 = 0.0;
        sdl_get_relative_mouse_state(&mut dx, &mut dy);
        self.moved = vec2(dx, dy);
        let now = sdl_get_ticks();
        self.frame_time = (now - self.now) as f32 / 1000.0;
        self.now = now;
        self.fit();
        let mut got: WGPUSurfaceTexture = zeroed();
        wgpu_surface_get_current_texture(self.surface, &mut got);
        // Not on screen (wgpu-native's `Occluded`), or out of date: nothing's drawn this frame.
        let ok = got.status == WGPUSurfaceGetCurrentTextureStatus::SuccessOptimal as i32
            || got.status == WGPUSurfaceGetCurrentTextureStatus::SuccessSuboptimal as i32;
        self.drawing = ok;
        if !ok {
            if got.status != OCCLUDED {
                self.width = 0;
            }
            return true;
        }
        self.frame = got.texture;
        let mut d: WGPUTextureViewDescriptor = zeroed();
        d.mip_level_count = UNDEFINED;
        d.array_layer_count = UNDEFINED;
        d.aspect = WGPUTextureAspect::All as i32;
        self.view = wgpu_texture_create_view(got.texture, &d);
        self.cleared = false;
        true
    }

    /// Shows what's been drawn this frame.
    pub fn present(&mut self) {
        if !self.drawing {
            sdl_delay(16);
            return;
        }
        wgpu_surface_present(self.surface);
        wgpu_texture_view_release(self.view);
        wgpu_texture_release(self.frame);
    }

    /// Writes `text` on a line of its own, to standard error: said at once, not buffered.
    pub fn say(&self, text: string) {
        write(2, text.c_str, text.len as u64);
        write(2, "\n", 1);
    }

    /// Whether `key` was pressed since the frame before.
    pub fn pressed(&self, key: Key) -> bool {
        let at = key as usize;
        if at < self.pressed.len { self.pressed[at] } else { false }
    }

    /// Whether `key` is held down.
    pub fn held(&self, key: Key) -> bool {
        let mut count: i32 = 0;
        let keys = sdl_get_keyboard_state(&mut count) as *bool;
        let at = key as i32;
        at < count && *keys.at(at as usize)
    }

    /// How far the mouse moved since the frame before, in points: across, and down.
    pub fn mouse_moved(&self) -> Vec2 = self.moved;

    /// Hides the mouse and keeps it in the window, for `mouse_moved` to steer by.
    pub fn grab_mouse(&mut self) {
        sdl_set_window_relative_mouse_mode(self.window, true);
    }

    /// Where the mouse is, as a fragment's `uv` is: from (0, 0) at the window's top left
    /// to (1, 1) at its bottom right.
    pub fn mouse(&self) -> Vec2 {
        let mut x: f32 = 0.0;
        let mut y: f32 = 0.0;
        sdl_get_mouse_state(&mut x, &mut y);
        let mut width = 0;
        let mut height = 0;
        sdl_get_window_size(self.window, &mut width, &mut height);
        if width == 0 || height == 0 {
            return vec2(0.0, 0.0);
        }
        vec2(x / width as f32, y / height as f32)
    }

    /// Whether the left mouse button is held down.
    pub fn left_held(&self) -> bool = buttons() & SDL_BUTTON_LMASK != 0;

    /// Whether the right mouse button is held down.
    pub fn right_held(&self) -> bool = buttons() & SDL_BUTTON_RMASK != 0;

    /// Seconds since the window opened.
    pub fn time(&self) -> f32 = (sdl_get_ticks() - self.start) as f32 / 1000.0;

    /// Seconds since the frame before started: how far to move things this frame.
    pub fn frame_time(&self) -> f32 = self.frame_time;

    /// Frames a second, going by this frame.
    pub fn fps(&self) -> i32 = if self.frame_time > 0.0 { (1.0 / self.frame_time + 0.5) as i32 } else { 0 };

    /// A texture `width` by `height` of `pixels`, 4 bytes each (red, green, blue, alpha), a
    /// row at a time: a shader's uniform.
    pub fn load_texture(&mut self, width: i32, height: i32, pixels: *) -> gpu::Texture {
        if self.loaded >= MAX_LOADED {
            @fail("too many textures");
        }
        let mut d: WGPUTextureDescriptor = zeroed();
        d.usage = TEXTURE_BINDING | TEXTURE_COPY_DST;
        d.dimension = WGPUTextureDimension::WGPUTextureDimension2D as i32;
        d.size.width = width as u32;
        d.size.height = height as u32;
        d.size.depth_or_array_layers = 1;
        d.format = WGPUTextureFormat::RGBA8Unorm as i32;
        d.mip_level_count = 1;
        d.sample_count = 1;
        let texture = wgpu_device_create_texture(self.device, &d);
        let mut to: WGPUTexelCopyTextureInfo = zeroed();
        to.texture = texture;
        to.aspect = WGPUTextureAspect::All as i32;
        let mut layout: WGPUTexelCopyBufferLayout = zeroed();
        layout.bytes_per_row = (width * 4) as u32;
        layout.rows_per_image = height as u32;
        let size = WGPUExtent3D { width: width as u32, height: height as u32, depth_or_array_layers: 1 };
        wgpu_queue_write_texture(self.queue, &to, pixels, (width * height * 4) as u64, &layout, &size);
        let mut v: WGPUTextureViewDescriptor = zeroed();
        v.mip_level_count = UNDEFINED;
        v.array_layer_count = UNDEFINED;
        v.aspect = WGPUTextureAspect::All as i32;
        let at = self.loaded;
        self.textures[at] = texture;
        self.views[at] = wgpu_texture_create_view(texture, &v);
        self.loaded = at + 1;
        gpu::Texture { id: self.loaded as u32, width, height }
    }

    /// Loads `grid` onto the GPU, as `grid.texture`: a pixel per cell, its number the red.
    pub fn load_grid(&mut self, grid: &mut gpu::Grid) {
        let mut pixels: [u32; 4096] = zeroed();
        let count = (grid.width * grid.height) as usize;
        if count > 4096 {
            @fail("a grid of at most 4096 cells");
        }
        for y in 0..grid.height {
            for x in 0..grid.width {
                let at = (y * grid.width + x) as usize;
                if at < 4096 {
                    pixels[at] = (grid.cell(x, y) as u32 & 255) | 4278190080;
                }
            }
        }
        grid.texture = self.load_texture(grid.width, grid.height, &pixels as *);
    }

    /// `len` `T`s on the GPU, each with every byte 0: for a kernel to fill.
    pub fn buffer<T>(&mut self, len: usize) -> gpu::Buffer<T> {
        let id = self.storage((len * size_of<T>()) as u64);
        gpu::Buffer { id, len }
    }

    /// `items`, copied onto the GPU.
    pub fn upload<T>(&mut self, items: &[T]) -> gpu::Buffer<T> {
        let buffer: gpu::Buffer<T> = self.buffer(items.len);
        self.write(&buffer, items);
        buffer
    }

    /// Copies `items` into `buffer`, from its start.
    pub fn write<T>(&mut self, buffer: &gpu::Buffer<T>, items: &[T]) {
        let size = (items.len * size_of<T>()) as u64;
        wgpu_queue_write_buffer(self.queue, self.storage_buffer(buffer.id), 0, items as *, size);
    }

    /// Copies `buffer`'s items back into `into`, as many as fit: waiting for the GPU to
    /// finish what it's been given first.
    pub fn read<T>(&mut self, buffer: &gpu::Buffer<T>, into: &mut [T]) {
        let count = if into.len < buffer.len { into.len } else { buffer.len };
        let size = (count * size_of<T>()) as u64;
        if size == 0 {
            return;
        }
        let mut d: WGPUBufferDescriptor = zeroed();
        d.usage = BUFFER_MAP_READ | BUFFER_COPY_DST;
        d.size = size;
        let staging = wgpu_device_create_buffer(self.device, &d);
        let encoder_descriptor: WGPUCommandEncoderDescriptor = zeroed();
        let encoder = wgpu_device_create_command_encoder(self.device, &encoder_descriptor);
        wgpu_command_encoder_copy_buffer_to_buffer(encoder, self.storage_buffer(buffer.id), 0, staging, 0, size);
        self.submit(encoder);

        let mut mapped = Waiting { done: false, ok: false, value: null() };
        let mut asked: WGPUBufferMapCallbackInfo = zeroed();
        asked.mode = WGPUCallbackMode::AllowProcessEvents as i32;
        asked.callback = got_mapped as *;
        asked.userdata1 = &mut mapped as *;
        wgpu_buffer_map_async(staging, MAP_READ, 0, size, asked);
        waited(self.instance, &mapped);
        if !mapped.ok {
            @fail("the GPU's buffer couldn't be read");
        }
        memcpy(into as *, wgpu_buffer_get_const_mapped_range(staging, 0, size), size);
        wgpu_buffer_unmap(staging);
        wgpu_buffer_release(staging);
    }

    /// A storage buffer of `size` bytes (at least 4), each 0: its `id`.
    fn storage(&mut self, size: u64) -> u32 {
        if self.buffer_count >= MAX_LOADED {
            @fail("too many buffers");
        }
        let size = (size + 3) / 4 * 4;
        let mut d: WGPUBufferDescriptor = zeroed();
        d.usage = BUFFER_STORAGE | BUFFER_COPY_DST | BUFFER_COPY_SRC;
        d.size = if size < 4 { 4 } else { size };
        let at = self.buffer_count;
        self.buffers[at] = wgpu_device_create_buffer(self.device, &d);
        self.buffer_sizes[at] = d.size;
        self.buffer_count = at + 1;
        self.buffer_count as u32
    }

    fn storage_buffer(&self, id: u32) -> WGPUBufferImpl {
        let at = (id - 1) as usize;
        if id == 0 || at >= self.buffer_count || at >= self.buffers.len {
            @fail("a buffer that isn't made");
        }
        self.buffers[at]
    }

    fn storage_size(&self, id: u32) -> u64 {
        let at = (id - 1) as usize;
        if id == 0 || at >= self.buffer_count || at >= self.buffer_sizes.len {
            @fail("a buffer that isn't made");
        }
        self.buffer_sizes[at]
    }

    fn texture_view(&self, id: u32) -> WGPUTextureViewImpl {
        let at = (id - 1) as usize;
        if id == 0 || at >= self.loaded || at >= self.views.len {
            @fail("a texture that isn't loaded");
        }
        self.views[at]
    }

    /// Runs what `encoder` holds.
    fn submit(&mut self, encoder: WGPUCommandEncoderImpl) {
        let finish: WGPUCommandBufferDescriptor = zeroed();
        let commands = wgpu_command_encoder_finish(encoder, &finish);
        wgpu_queue_submit(self.queue, 1, &commands);
        wgpu_command_buffer_release(commands);
        wgpu_command_encoder_release(encoder);
    }
}

fn got_mapped(status: i32, message: WGPUStringView, into: *, unused: *) {
    let waiting = (into as *Waiting).at_mut(0);
    waiting.done = true;
    waiting.ok = status == WGPUMapAsyncStatus::Success as i32;
}

extern {
    fn memcpy(to: *, from: *, count: u64) -> *;
}

impl Drop for Gpu {
    fn drop(&mut self) {
        for i in 0..self.views.len {
            if i < self.loaded {
                wgpu_texture_view_release(self.views[i]);
                wgpu_texture_release(self.textures[i]);
            }
            if i < self.buffer_count {
                wgpu_buffer_release(self.buffers[i]);
            }
        }
        sdl_destroy_window(self.window);
        sdl_quit();
    }
}

/// The uniforms as they're written to the GPU's buffer: each at the next multiple of its
/// alignment, as WGSL lays out a uniform buffer (see `gpu::shader`).
struct Packing {
    /// The next free byte.
    at: usize,
    words: [u32; UNIFORM_WORDS],
    /// Each texture's and buffer's `id`, in order: a buffer's with `BUFFER_ID` set.
    bound: [u32; MAX_BOUND],
    bound_count: usize,
}

impl Packing {
    fn new() -> Packing = Packing { at: 0, words: zeroed(), bound: zeroed(), bound_count: 0 };

    fn align(&mut self, to: usize) {
        if to == 0 {
            return;
        }
        self.at = (self.at + to - 1) / to * to;
    }

    fn word(&mut self, bits: u32) {
        let i = self.at / 4;
        if i < UNIFORM_WORDS {
            self.words[i] = bits;
        }
        self.at = self.at + 4;
    }

    fn float(&mut self, x: f32) {
        let mut bits: u32 = 0;
        (&mut bits as *f32).put(0, x);
        self.word(bits);
    }

    /// `count` items of `size` numbers each from `data`.
    fn numbers(&mut self, n: gpu::Numbers) {
        let size = n.size as usize;
        let words = n.data as *u32;
        // One vector, `[f32; 3]`: as a `vec3`.
        if n.count == 1 && size >= 2 {
            self.align(if size == 2 { 8 } else { 16 });
            for c in 0..size {
                self.word(*words.at(c));
            }
            return;
        }
        // An array: each item 16 bytes apart.
        for k in 0..n.count as usize {
            self.align(16);
            for c in 0..size {
                self.word(*words.at(k * size + c));
            }
        }
        self.align(16);
    }

    /// `count` columns of `size` numbers each, 16 bytes apart: a `Matrix`.
    fn columns(&mut self, n: gpu::Numbers) {
        let size = n.size as usize;
        let words = n.data as *u32;
        for k in 0..n.count as usize {
            self.align(16);
            for c in 0..size {
                self.word(*words.at(k * size + c));
            }
        }
        self.align(16);
    }

    fn bind(&mut self, id: u32) {
        if self.bound_count < MAX_BOUND {
            self.bound[self.bound_count] = id;
        }
        self.bound_count = self.bound_count + 1;
    }

    /// The uniform buffer's size: a multiple of 16, at least 16.
    fn size(&self) -> u64 {
        let size = (self.at + 15) / 16 * 16;
        if size < 16 { 16 } else { size as u64 }
    }
}

fn pack(into: *, value: gpu::Uniform) {
    let p = (into as *Packing).at_mut(0);
    match value {
        gpu::Uniform::Float(x) => {
            p.align(4);
            p.float(x);
        }
        gpu::Uniform::Int(x) => {
            p.align(4);
            p.word(x as u32);
        }
        gpu::Uniform::Uint(x) => {
            p.align(4);
            p.word(x);
        }
        gpu::Uniform::Bool(b) => {
            p.align(4);
            p.word(if b { 1 } else { 0 });
        }
        gpu::Uniform::Vec2(v) => {
            p.align(8);
            p.float(v[0]);
            p.float(v[1]);
        }
        gpu::Uniform::Vec3(v) => {
            p.align(16);
            p.float(v[0]);
            p.float(v[1]);
            p.float(v[2]);
        }
        gpu::Uniform::Vec4(v) => {
            p.align(16);
            p.float(v[0]);
            p.float(v[1]);
            p.float(v[2]);
            p.float(v[3]);
        }
        gpu::Uniform::Numbers(n) => p.numbers(n),
        gpu::Uniform::Matrix(n) => p.columns(n),
        gpu::Uniform::Texture(t) => p.bind(t.id),
        gpu::Uniform::Buffer(id) => p.bind(BUFFER_ID | id),
    }
}

/// What a shader or kernel binds, made the first time it runs: the layout of its bindings,
/// its uniform buffer and its sampler. Binding 0 is the uniforms, 1 the sampler, then each
/// texture and buffer among the uniforms, then (for a kernel) the buffer it fills.
struct Bindings {
    layout: WGPUBindGroupLayoutImpl,
    pipeline_layout: WGPUPipelineLayoutImpl,
    uniforms: WGPUBufferImpl,
    sampler: WGPUSamplerImpl,
    size: u64,
}

fn bindings(gpu: &mut Gpu, packing: &Packing, fills: bool) -> Bindings {
    let visible = STAGE_FRAGMENT | STAGE_COMPUTE;
    let mut entries: [WGPUBindGroupLayoutEntry; 12] = zeroed();
    entries[0].binding = 0;
    entries[0].visibility = visible;
    entries[0].buffer.type_ = WGPUBufferBindingType::Uniform as i32;
    entries[1].binding = 1;
    entries[1].visibility = visible;
    entries[1].sampler.type_ = WGPUSamplerBindingType::Filtering as i32;
    let mut count: usize = 2;
    for k in 0..MAX_BOUND {
        if k < packing.bound_count && count < 12 {
            entries[count].binding = count as u32;
            entries[count].visibility = visible;
            if packing.bound[k] & BUFFER_ID != 0 {
                entries[count].buffer.type_ = WGPUBufferBindingType::ReadOnlyStorage as i32;
            } else {
                entries[count].texture.sample_type = WGPUTextureSampleType::Float as i32;
                entries[count].texture.view_dimension = WGPUTextureViewDimension::WGPUTextureViewDimension2D as i32;
            }
            count = count + 1;
        }
    }
    if fills && count < 12 {
        entries[count].binding = count as u32;
        entries[count].visibility = STAGE_COMPUTE;
        entries[count].buffer.type_ = WGPUBufferBindingType::Storage as i32;
        count = count + 1;
    }
    let mut layout_descriptor: WGPUBindGroupLayoutDescriptor = zeroed();
    layout_descriptor.entry_count = count as u64;
    layout_descriptor.entries = &entries as *;
    let layout = wgpu_device_create_bind_group_layout(gpu.device, &layout_descriptor);
    let layouts = [layout];
    let mut pipeline_layout_descriptor: WGPUPipelineLayoutDescriptor = zeroed();
    pipeline_layout_descriptor.bind_group_layout_count = 1;
    pipeline_layout_descriptor.bind_group_layouts = &layouts as *;
    let pipeline_layout = wgpu_device_create_pipeline_layout(gpu.device, &pipeline_layout_descriptor);

    let size = packing.size();
    let mut buffer_descriptor: WGPUBufferDescriptor = zeroed();
    buffer_descriptor.usage = BUFFER_UNIFORM | BUFFER_COPY_DST;
    buffer_descriptor.size = size;
    let uniforms = wgpu_device_create_buffer(gpu.device, &buffer_descriptor);

    let mut sampler_descriptor: WGPUSamplerDescriptor = zeroed();
    sampler_descriptor.address_mode_u = WGPUAddressMode::ClampToEdge as i32;
    sampler_descriptor.address_mode_v = WGPUAddressMode::ClampToEdge as i32;
    sampler_descriptor.address_mode_w = WGPUAddressMode::ClampToEdge as i32;
    sampler_descriptor.mag_filter = WGPUFilterMode::Nearest as i32;
    sampler_descriptor.min_filter = WGPUFilterMode::Nearest as i32;
    sampler_descriptor.mipmap_filter = WGPUMipmapFilterMode::Nearest as i32;
    sampler_descriptor.lod_max_clamp = 32.0;
    sampler_descriptor.max_anisotropy = 1;
    let sampler = wgpu_device_create_sampler(gpu.device, &sampler_descriptor);
    Bindings { layout, pipeline_layout, uniforms, sampler, size }
}

impl Bindings {
    /// Writes `packing`'s uniforms, and binds them and what it binds; then `fills`, a
    /// buffer's `id`, if it's not 0.
    fn group(&self, gpu: &mut Gpu, packing: &Packing, fills: u32) -> WGPUBindGroupImpl {
        wgpu_queue_write_buffer(gpu.queue, self.uniforms, 0, &packing.words as *, self.size);
        let mut entries: [WGPUBindGroupEntry; 12] = zeroed();
        entries[0].binding = 0;
        entries[0].buffer = self.uniforms;
        entries[0].size = self.size;
        entries[1].binding = 1;
        entries[1].sampler = self.sampler;
        let mut count: usize = 2;
        for k in 0..MAX_BOUND {
            if k < packing.bound_count && count < 12 {
                let id = packing.bound[k];
                entries[count].binding = count as u32;
                if id & BUFFER_ID != 0 {
                    let buffer = id & (BUFFER_ID - 1);
                    entries[count].buffer = gpu.storage_buffer(buffer);
                    entries[count].size = gpu.storage_size(buffer);
                } else {
                    entries[count].texture_view = gpu.texture_view(id);
                }
                count = count + 1;
            }
        }
        if fills != 0 && count < 12 {
            entries[count].binding = count as u32;
            entries[count].buffer = gpu.storage_buffer(fills);
            entries[count].size = gpu.storage_size(fills);
            count = count + 1;
        }
        let mut d: WGPUBindGroupDescriptor = zeroed();
        d.layout = self.layout;
        d.entry_count = count as u64;
        d.entries = &entries as *;
        wgpu_device_create_bind_group(gpu.device, &d)
    }
}

fn shader_module(gpu: &mut Gpu, wgsl: string) -> WGPUShaderModuleImpl {
    let mut source: WGPUShaderSourceWGSL = zeroed();
    source.chain.s_type = WGPUSType::ShaderSourceWGSL as i32;
    source.code = WGPUStringView { data: wgsl.c_str, length: wgsl.len as u64 };
    let mut d: WGPUShaderModuleDescriptor = zeroed();
    d.next_in_chain = &source as *;
    wgpu_device_create_shader_module(gpu.device, &d)
}

/// A fragment shader drawn with WebGPU, loaded the first time it's drawn: a closure,
/// `(frag) => …`, whose captures are its uniforms (`Shader::empty()`, each closure written
/// out its own shader, so one `Shader` draws one); or a `@fragment` function and its struct
/// of uniforms (`Shader::fragment(stripes)`). What it gives is blended over what's drawn by
/// its alpha.
pub struct Shader<U> {
    loaded: bool,
    shader: gpu::Shader<U>,
    pipeline: WGPURenderPipelineImpl,
    bindings: Bindings,
}

impl<U: fn(gpu::Fragment) -> Vector<4, f32>> Shader<U> {
    /// For a shader closure, drawn below: the bound is what tells it `frag` is a `Fragment`.
    /// Nothing is loaded yet: it is, the first time it's drawn.
    pub fn empty() -> Shader<U> {
        Shader { loaded: false, shader: gpu::Shader { wgsl: "" }, pipeline: zeroed(), bindings: zeroed() }
    }
}

impl<U> Shader<U> {
    /// `@fragment` function `entry`, drawn with a `U` of uniforms.
    pub fn fragment<F: fn(gpu::Fragment, &U) -> Vector<4, f32>>(entry: F) -> Shader<U> {
        Shader { loaded: false, shader: gpu::Shader::fragment(entry), pipeline: zeroed(), bindings: zeroed() }
    }

    /// The shader, closure `uniforms`, over the whole window.
    pub fn fullscreen(&mut self, gpu: &mut Gpu, uniforms: U) {
        self.draw(gpu, 0.0, 0.0, gpu.width as f32, gpu.height as f32, uniforms);
    }

    /// The shader, closure `uniforms`, over `width` by `height` pixels at `x`, `y`: its
    /// `frag.uv` goes from (0, 0) at the top left to (1, 1) at the bottom right.
    /// Only what's inside the window is drawn: a shader partly outside it is squeezed into
    /// the part inside.
    pub fn draw(&mut self, gpu: &mut Gpu, x: f32, y: f32, width: f32, height: f32, uniforms: U) {
        // WebGPU draws only inside what's drawn to.
        let left = x.max(0.0);
        let top = y.max(0.0);
        let right = (x + width).min(gpu.width as f32);
        let bottom = (y + height).min(gpu.height as f32);
        if !gpu.drawing || right <= left || bottom <= top {
            return;
        }
        let mut packing = Packing::new();
        let into = &mut packing as *;
        self.shader.each(&uniforms, (i, name, value) => pack(into, value));
        if !self.loaded {
            if self.shader.wgsl.len == 0 {
                self.shader.wgsl = gpu::shader(&uniforms);
            }
            self.load(gpu, self.shader.wgsl, &packing);
        }
        let group = self.bindings.group(gpu, &packing, 0);

        let encoder_descriptor: WGPUCommandEncoderDescriptor = zeroed();
        let encoder = wgpu_device_create_command_encoder(gpu.device, &encoder_descriptor);
        let mut attachment: WGPURenderPassColorAttachment = zeroed();
        attachment.view = gpu.view;
        attachment.depth_slice = UNDEFINED;
        attachment.load_op = if gpu.cleared { WGPULoadOp::Load as i32 } else { WGPULoadOp::Clear as i32 };
        attachment.store_op = WGPUStoreOp::Store as i32;
        attachment.clear_value = WGPUColor { r: 0.0, g: 0.0, b: 0.0, a: 1.0 };
        gpu.cleared = true;
        let mut pass_descriptor: WGPURenderPassDescriptor = zeroed();
        pass_descriptor.color_attachment_count = 1;
        pass_descriptor.color_attachments = &attachment as *;
        let pass = wgpu_command_encoder_begin_render_pass(encoder, &pass_descriptor);
        wgpu_render_pass_encoder_set_pipeline(pass, self.pipeline);
        let no_offsets: u32 = 0;
        wgpu_render_pass_encoder_set_bind_group(pass, 0, group, 0, &no_offsets);
        wgpu_render_pass_encoder_set_viewport(pass, left, top, right - left, bottom - top, 0.0, 1.0);
        wgpu_render_pass_encoder_draw(pass, 3, 1, 0, 0);
        wgpu_render_pass_encoder_end(pass);
        wgpu_render_pass_encoder_release(pass);
        gpu.submit(encoder);
        wgpu_bind_group_release(group);
    }

    fn load(&mut self, gpu: &mut Gpu, wgsl: string, packing: &Packing) {
        let module = shader_module(gpu, wgsl);
        self.bindings = bindings(gpu, packing, false);
        // Over what's there by its alpha.
        let mut blend: WGPUBlendState = zeroed();
        blend.color.operation = WGPUBlendOperation::Add as i32;
        blend.color.src_factor = WGPUBlendFactor::SrcAlpha as i32;
        blend.color.dst_factor = WGPUBlendFactor::OneMinusSrcAlpha as i32;
        blend.alpha.operation = WGPUBlendOperation::Add as i32;
        blend.alpha.src_factor = WGPUBlendFactor::One as i32;
        blend.alpha.dst_factor = WGPUBlendFactor::OneMinusSrcAlpha as i32;
        let mut target: WGPUColorTargetState = zeroed();
        target.format = gpu.format;
        target.write_mask = WRITE_ALL;
        target.blend = &blend as *;
        let mut fragment: WGPUFragmentState = zeroed();
        fragment.module = module;
        fragment.entry_point = view("fs_main");
        fragment.target_count = 1;
        fragment.targets = &target as *;
        let mut d: WGPURenderPipelineDescriptor = zeroed();
        d.layout = self.bindings.pipeline_layout;
        d.vertex.module = module;
        d.vertex.entry_point = view("vs_main");
        d.primitive.topology = WGPUPrimitiveTopology::TriangleList as i32;
        d.primitive.front_face = WGPUFrontFace::Ccw as i32;
        d.primitive.cull_mode = WGPUCullMode::None as i32;
        d.multisample.count = 1;
        d.multisample.mask = UNDEFINED;
        d.fragment = &fragment as *;
        self.pipeline = wgpu_device_create_render_pipeline(gpu.device, &d);
        self.loaded = true;
    }
}

/// A compute kernel written as a closure, `(i) => …`, run with WebGPU: once for each item of
/// a buffer of `T`s, giving it. Compiled to WGSL and loaded the first time it runs; each
/// closure written out is its own kernel, so one `Kernel` runs one.
pub struct Kernel<T, F> {
    loaded: bool,
    shader: gpu::Shader<F>,
    /// What it fills is a buffer of `T`s.
    filled: gpu::Buffer<T>,
    pipeline: WGPUComputePipelineImpl,
    bindings: Bindings,
}

impl<T, F: fn(usize) -> T> Kernel<T, F> {
    /// Nothing loaded yet: it is the first time it runs.
    pub fn empty() -> Kernel<T, F> {
        Kernel {
            loaded: false,
            shader: gpu::Shader { wgsl: "" },
            filled: gpu::Buffer { id: 0, len: 0 },
            pipeline: zeroed(),
            bindings: zeroed(),
        }
    }
}

impl<T, F> Kernel<T, F> {
    /// Fills `items`: its item `i` is what `kernel` gives for `i`, worked out on the GPU.
    pub fn fill(&mut self, gpu: &mut Gpu, items: &gpu::Buffer<T>, kernel: F) {
        let mut packing = Packing::new();
        let into = &mut packing as *;
        self.shader.each(&kernel, (i, name, value) => pack(into, value));
        if !self.loaded {
            self.load(gpu, gpu::kernel(&kernel), &packing);
        }
        let group = self.bindings.group(gpu, &packing, items.id);
        let encoder_descriptor: WGPUCommandEncoderDescriptor = zeroed();
        let encoder = wgpu_device_create_command_encoder(gpu.device, &encoder_descriptor);
        let pass_descriptor: WGPUComputePassDescriptor = zeroed();
        let pass = wgpu_command_encoder_begin_compute_pass(encoder, &pass_descriptor);
        wgpu_compute_pass_encoder_set_pipeline(pass, self.pipeline);
        let no_offsets: u32 = 0;
        wgpu_compute_pass_encoder_set_bind_group(pass, 0, group, 0, &no_offsets);
        let groups = (items.len + 63) / 64;
        wgpu_compute_pass_encoder_dispatch_workgroups(pass, groups as u32, 1, 1);
        wgpu_compute_pass_encoder_end(pass);
        wgpu_compute_pass_encoder_release(pass);
        gpu.submit(encoder);
        wgpu_bind_group_release(group);
    }

    fn load(&mut self, gpu: &mut Gpu, wgsl: string, packing: &Packing) {
        let module = shader_module(gpu, wgsl);
        self.bindings = bindings(gpu, packing, true);
        let mut d: WGPUComputePipelineDescriptor = zeroed();
        d.layout = self.bindings.pipeline_layout;
        d.compute.module = module;
        d.compute.entry_point = view("cs_main");
        self.pipeline = wgpu_device_create_compute_pipeline(gpu.device, &d);
        self.loaded = true;
    }
}

/// What a `Painter` paints with: one shape at a time, each a quad the shader is drawn over.
struct Shape {
    /// `RECT`, `CIRCLE` or `TEXT`.
    pub kind: i32,
    pub colour: Vector<4, f32>,
    /// The text's characters, `count` of them, by their codes.
    pub glyphs: [i32; MAX_GLYPHS],
    pub count: i32,
    /// `FONT`'s glyphs side by side, white where they're drawn.
    pub font: gpu::Texture,
}

@const RECT: i32 = 0;
@const CIRCLE: i32 = 1;
@const TEXT: i32 = 2;
/// The most characters `Painter::text` draws at once.
@const MAX_GLYPHS: usize = 64;
/// A glyph's size in `FONT`, and the room it takes in text: a column and a row more.
@const GLYPH_W: usize = 5;
@const GLYPH_H: usize = 7;
@const GLYPHS: usize = 95;

@fragment
fn painted(frag: gpu::Fragment, s: &Shape) -> Vector<4, f32> {
    let clear = vec4(0.0, 0.0, 0.0, 0.0);
    if s.kind == CIRCLE {
        let d = frag.uv - vec2(0.5, 0.5);
        if d.length > 0.5 {
            return clear;
        }
    }
    if s.kind == TEXT {
        let x = (frag.uv.x * (s.count as usize * (GLYPH_W + 1)) as f32) as usize;
        let y = (frag.uv.y * (GLYPH_H + 1) as f32) as usize;
        let i = x / (GLYPH_W + 1);
        let column = x - i * (GLYPH_W + 1);
        if column >= GLYPH_W || y >= GLYPH_H || i >= MAX_GLYPHS {
            return clear;
        }
        let code = s.glyphs[i] - 32;
        if code < 0 || code >= GLYPHS as i32 || s.font.cell(code * GLYPH_W as i32 + column as i32, y as i32) == 0 {
            return clear;
        }
    }
    s.colour
}

/// Draws flat shapes and text over what's drawn: a game's score, a crosshair, a health bar.
/// Positions and sizes are in points, from the window's top left, as it was opened.
pub struct Painter {
    shader: Shader<Shape>,
    font: gpu::Texture,
}

impl Painter {
    /// Loads the font.
    pub fn new(gpu: &mut Gpu) -> Painter {
        let width = GLYPHS * GLYPH_W;
        let mut pixels: [u32; GLYPHS * GLYPH_W * GLYPH_H] = zeroed();
        for code in 0..GLYPHS {
            for row in 0..GLYPH_H {
                let bits = FONT[code * GLYPH_H + row];
                for column in 0..GLYPH_W {
                    if bits & (16 >> column as u8) != 0 {
                        pixels[row * width + code * GLYPH_W + column] = 4294967295;
                    }
                }
            }
        }
        let font = gpu.load_texture(width as i32, GLYPH_H as i32, &pixels as *);
        Painter { shader: Shader::fragment(painted), font }
    }

    fn shape(&mut self, gpu: &mut Gpu, x: f32, y: f32, width: f32, height: f32, kind: i32, colour: Vector<4, f32>) {
        let shape = Shape { kind, colour, glyphs: [0; MAX_GLYPHS], count: 0, font: self.font };
        let k = gpu.scale;
        self.shader.draw(gpu, x * k, y * k, width * k, height * k, shape);
    }

    /// A rectangle `width` by `height` at `x`, `y`.
    pub fn rect(&mut self, gpu: &mut Gpu, x: f32, y: f32, width: f32, height: f32, colour: Vector<4, f32>) {
        self.shape(gpu, x, y, width, height, RECT, colour);
    }

    /// A circle of `radius` around `x`, `y`.
    pub fn circle(&mut self, gpu: &mut Gpu, x: f32, y: f32, radius: f32, colour: Vector<4, f32>) {
        self.shape(gpu, x - radius, y - radius, radius * 2.0, radius * 2.0, CIRCLE, colour);
    }

    /// `text` with its top left at `x`, `y`, `size` pixels high: the first 64 characters, of
    /// those from space to `~`.
    pub fn text(&mut self, gpu: &mut Gpu, x: f32, y: f32, size: f32, text: string, colour: Vector<4, f32>) {
        let mut glyphs = [0; MAX_GLYPHS];
        let count = if text.len < MAX_GLYPHS { text.len } else { MAX_GLYPHS };
        for i in 0..glyphs.len {
            glyphs[i] = (text.get(i) else 0) as i32;
        }
        let shape = Shape { kind: TEXT, colour, glyphs, count: count as i32, font: self.font };
        let scale = size / (GLYPH_H + 1) as f32;
        let width = (count * (GLYPH_W + 1)) as f32 * scale;
        let k = gpu.scale;
        self.shader.draw(gpu, x * k, y * k, width * k, size * k, shape);
    }

    /// How wide `text` is, `size` pixels high.
    pub fn text_width(&self, text: string, size: f32) -> f32 {
        let count = if text.len < MAX_GLYPHS { text.len } else { MAX_GLYPHS };
        (count * (GLYPH_W + 1)) as f32 * size / (GLYPH_H + 1) as f32
    }
}

/// A 5 by 7 font for the characters from space to `~`: each one's 7 rows, top first, each
/// row's 5 columns a bit each, the leftmost the highest.
@const FONT: [u8; GLYPHS * GLYPH_H] = [
    0, 0, 0, 0, 0, 0, 0, 4, 4, 4, 4, 4, 0, 4,
    10, 10, 10, 0, 0, 0, 0, 10, 10, 31, 10, 31, 10, 10,
    4, 15, 20, 14, 5, 30, 4, 24, 25, 2, 4, 8, 19, 3,
    12, 18, 20, 8, 21, 18, 13, 4, 4, 4, 0, 0, 0, 0,
    2, 4, 8, 8, 8, 4, 2, 8, 4, 2, 2, 2, 4, 8,
    0, 4, 21, 14, 21, 4, 0, 0, 4, 4, 31, 4, 4, 0,
    0, 0, 0, 0, 12, 4, 8, 0, 0, 0, 31, 0, 0, 0,
    0, 0, 0, 0, 0, 12, 12, 0, 1, 2, 4, 8, 16, 0,
    14, 17, 19, 21, 25, 17, 14, 4, 12, 4, 4, 4, 4, 14,
    14, 17, 1, 2, 4, 8, 31, 31, 2, 4, 2, 1, 17, 14,
    2, 6, 10, 18, 31, 2, 2, 31, 16, 30, 1, 1, 17, 14,
    6, 8, 16, 30, 17, 17, 14, 31, 1, 2, 4, 8, 8, 8,
    14, 17, 17, 14, 17, 17, 14, 14, 17, 17, 15, 1, 2, 12,
    0, 12, 12, 0, 12, 12, 0, 0, 12, 12, 0, 12, 4, 8,
    2, 4, 8, 16, 8, 4, 2, 0, 0, 31, 0, 31, 0, 0,
    8, 4, 2, 1, 2, 4, 8, 14, 17, 1, 2, 4, 0, 4,
    14, 17, 1, 13, 21, 21, 14, 14, 17, 17, 31, 17, 17, 17,
    30, 17, 17, 30, 17, 17, 30, 14, 17, 16, 16, 16, 17, 14,
    28, 18, 17, 17, 17, 18, 28, 31, 16, 16, 30, 16, 16, 31,
    31, 16, 16, 30, 16, 16, 16, 14, 17, 16, 23, 17, 17, 15,
    17, 17, 17, 31, 17, 17, 17, 14, 4, 4, 4, 4, 4, 14,
    7, 2, 2, 2, 2, 18, 12, 17, 18, 20, 24, 20, 18, 17,
    16, 16, 16, 16, 16, 16, 31, 17, 27, 21, 21, 17, 17, 17,
    17, 17, 25, 21, 19, 17, 17, 14, 17, 17, 17, 17, 17, 14,
    30, 17, 17, 30, 16, 16, 16, 14, 17, 17, 17, 21, 18, 13,
    30, 17, 17, 30, 20, 18, 17, 15, 16, 16, 14, 1, 1, 30,
    31, 4, 4, 4, 4, 4, 4, 17, 17, 17, 17, 17, 17, 14,
